@page "/partenaire/etablissements/{Id:guid}/abonnement"
@inject PartnerApiClient PartnerApi
@inject PartnerSessionService Session
@inject NavigationManager Navigation
@* prerender:false : voir PartnerDashboard.razor pour le detail du bug de prerendering evite. *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Abonnement</PageTitle>
@using KekeBeauty.Web.Components.Layout

<PartnerDesktopHeader ActivePath="abonnement" IdEtablissement="Id" />

<header class="lg:hidden fixed top-0 inset-x-0 z-50 bg-surface/90 backdrop-blur-xl shadow-[0_1px_8px_rgba(58,13,82,0.04)] pt-safe">
    <div class="h-16 px-margin flex items-center justify-between gap-space-sm">
        <div class="flex items-center gap-space-xs min-w-0">
            <a aria-label="Retour" class="w-11 h-11 -ml-2 rounded-full flex items-center justify-center text-text-primary hover:text-primary transition-colors active:scale-95" href="@($"/partenaire/etablissements/{Id}")">
                <span class="material-symbols-outlined text-[22px]">arrow_back_ios_new</span>
            </a>
            <h1 class="font-headline-sm text-headline-sm text-text-primary truncate">Abonnement</h1>
        </div>
    </div>
</header>

<main id="main-content" tabindex="-1" class="flex flex-col relative w-full pt-16 lg:pt-24 pb-safe bg-surface min-h-screen">
    <div class="flex flex-col w-full pb-10 px-margin lg:max-w-3xl lg:mx-auto">

        @if (_checkingAuth)
        {
            <p class="font-body-md text-body-md text-on-surface-variant pt-space-md">Chargement…</p>
        }
        else
        {
            <section class="partner-hero mt-space-sm mb-6">
                <div class="partner-hero-glow" aria-hidden="true"></div>
                <div class="relative z-10 flex flex-wrap items-center justify-between gap-space-md">
                    <div>
                        <p class="font-label-sm text-label-sm uppercase tracking-[0.18em] partner-hero-eyebrow mb-1">Abonnement</p>
                        <h1 class="font-headline-lg text-headline-lg text-white font-bold partner-hero-title">Formule @(_usage?.Libelle ?? _usage?.Formule)</h1>
                        <p class="font-body-sm text-body-sm partner-hero-sub mt-1">@(_usage is not null ? UsageLabel(_usage) : "")</p>
                    </div>
                </div>
            </section>

            <div class="grid sm:grid-cols-2 gap-4 pt-3">
                @foreach (var formule in _formules)
                {
                    var estActuelle = formule.Formule == _usage?.Formule;
                    var souscriptible = formule.EstActif && (formule.TarifMensuel is not null || formule.TarifAnnuel is not null);
                    <article class="plan-card @(estActuelle ? "is-active" : "") @(souscriptible && !estActuelle ? "plan-card-pro" : "")">
                        @if (formule.EstPromoActive)
                        {
                            <span class="plan-card-ribbon plan-card-ribbon-promo">Promo -@(formule.PromoPourcentage)%</span>
                        }
                        else if (estActuelle)
                        {
                            <span class="plan-card-ribbon">Formule actuelle</span>
                        }
                        <h3 class="font-headline-sm text-headline-sm">@formule.Libelle</h3>
                        <p class="plan-card-price">
                            @if (formule.TarifMensuel is null && formule.TarifAnnuel is null)
                            {
                                <text>Gratuit</text>
                            }
                            else
                            {
                                @if (formule.EstPromoActive)
                                {
                                    <span class="plan-card-price-barre">@((formule.TarifMensuel ?? formule.TarifAnnuel)!.Value.ToString("N0"))</span>
                                }
                                @((formule.TarifMensuelEffectif ?? formule.TarifAnnuelEffectif)!.Value.ToString("N0")) <span>FCFA @(formule.TarifMensuel is not null ? "/ mois" : "/ an")</span>
                            }
                        </p>
                        <ul class="mt-3 space-y-2 font-body-sm text-body-sm @(souscriptible && !estActuelle ? "opacity-95" : "text-on-surface-variant")">
                            <li><span class="material-symbols-outlined">check_circle</span>Boutique visible dans l’annuaire</li>
                            <li><span class="material-symbols-outlined">check_circle</span>@LimiteLabel(formule, true)</li>
                            <li><span class="material-symbols-outlined">check_circle</span>@LimiteLabel(formule, false)</li>
                            <li><span class="material-symbols-outlined">check_circle</span>@(formule.PaiementMobile ? "Paiement mobile" : "Paiement en espèces")</li>
                            @if (formule.GestionEquipe) { <li><span class="material-symbols-outlined">check_circle</span>Gestion de l’équipe</li> }
                            @if (formule.StatistiquesAvancees) { <li><span class="material-symbols-outlined">check_circle</span>Revenus et statistiques détaillés</li> }
                            @foreach (var avantage in formule.Avantages)
                            {
                                <li><span class="material-symbols-outlined">check_circle</span>@avantage</li>
                            }
                        </ul>
                        @if (estActuelle)
                        {
                            <p class="mt-4 font-label-sm text-label-sm text-primary bg-lavender-subtle rounded-full px-3 py-1.5 inline-block">@UsageLabel(_usage!)</p>
                        }
                        else if (souscriptible)
                        {
                            <button class="mt-4 w-full py-2.5 rounded-full bg-white/95 text-primary font-label-md text-label-md font-bold shadow-md" type="button" @onclick="() => SelectFormule(formule)">Choisir @formule.Libelle</button>
                        }
                    </article>
                }
            </div>

            @if (_formuleChoisie is not null)
            {
                <h3 class="font-label-lg text-label-lg text-text-primary pt-6" id="periodicite-choix">Choisissez la facturation du pack @_formuleChoisie.Libelle</h3>
                @if (_formuleChoisie.EstPromoActive)
                {
                    <p class="font-body-sm text-body-sm text-error mt-1">Promotion -@(_formuleChoisie.PromoPourcentage)% @(_formuleChoisie.PromoFin is not null ? $"jusqu'au {_formuleChoisie.PromoFin.Value.LocalDateTime:dd/MM/yyyy HH:mm}" : "")</p>
                }

                <div class="space-y-3 pt-2">
                    @if (_formuleChoisie.TarifMensuel is not null)
                    {
                        <button class="w-full text-left p-space-md rounded-xl shadow-sm transition-all @(_periodicite == "MENSUEL" ? "bg-primary-container text-on-primary" : "bg-surface-cream text-text-primary")" type="button" @onclick='() => _periodicite = "MENSUEL"'>
                            <div class="flex items-center justify-between">
                                <span class="font-label-lg text-label-lg font-bold">Mensuel · @_formuleChoisie.TarifMensuelEffectif!.Value.ToString("N0") FCFA</span>
                                @if (_periodicite == "MENSUEL")
                                {
                                    <span class="material-symbols-outlined text-[20px]">check_circle</span>
                                }
                            </div>
                            <span class="font-body-sm text-body-sm opacity-80">Facturation chaque mois</span>
                        </button>
                    }
                    @if (_formuleChoisie.TarifAnnuel is not null)
                    {
                        <button class="w-full text-left p-space-md rounded-xl shadow-sm transition-all @(_periodicite == "ANNUEL" ? "bg-primary-container text-on-primary" : "bg-surface-cream text-text-primary")" type="button" @onclick='() => _periodicite = "ANNUEL"'>
                            <div class="flex items-center justify-between">
                                <span class="font-label-lg text-label-lg font-bold">Annuel · @_formuleChoisie.TarifAnnuelEffectif!.Value.ToString("N0") FCFA</span>
                                @if (_periodicite == "ANNUEL")
                                {
                                    <span class="material-symbols-outlined text-[20px]">check_circle</span>
                                }
                            </div>
                            <span class="font-body-sm text-body-sm opacity-80">Facturation annuelle</span>
                        </button>
                    }
                </div>

                <ToastBridge Message="@_message" Severity="@(_ok ? "success" : "danger")" OnShown="@(() => _message = null)" />

                @if (!string.IsNullOrEmpty(_checkoutUrl))
                {
                    <a class="mt-space-md block text-center px-4 py-3.5 rounded-full bg-gradient-to-r from-primary via-primary-container to-secondary text-on-primary font-label-lg text-label-lg shadow-md" href="@_checkoutUrl" target="_blank" rel="noopener">Payer maintenant en ligne</a>
                }

                <button class="mt-space-lg w-full py-3.5 px-space-md rounded-full bg-primary-container text-on-primary font-label-lg text-label-lg shadow-lg disabled:opacity-60" type="button" @onclick="SubscribeAsync" disabled="@_busy">
                    @(_busy ? "Traitement en cours..." : $"Souscrire {_formuleChoisie.Libelle}")
                </button>
            }
            <section class="mt-6 bg-surface-cream rounded-xl p-4 shadow-sm"><h3 class="font-headline-sm text-headline-sm">Historique et factures</h3>@if(_history.Count==0){<p class="text-body-sm text-on-surface-variant mt-2">Aucun abonnement payant.</p>}else{<div class="mt-3 space-y-2">@foreach(var item in _history){<div class="summary-row"><span class="material-symbols-outlined">receipt_long</span><div class="flex-1"><strong>@item.Formule · @item.Periodicite · @item.Montant.ToString("N0") FCFA</strong><small>@item.DateDebutEngagement.ToString("dd/MM/yyyy") · @item.StatutAbonnement</small></div><a class="text-primary" href="@($"/partenaire/etablissements/{Id}/abonnements/{item.IdAbonnement}/recu")">Reçu</a></div>}</div>}</section>
        }
    </div>
</main>

@code {
    [Parameter] public Guid Id { get; set; }

    private Guid? _idPartner;
    private bool _checkingAuth = true;
    private string _periodicite = "MENSUEL";
    private bool _busy;
    private bool _ok;
    private string? _message;
    private string? _checkoutUrl;
    private PlanUsageDto? _usage;
    private List<PlanUsageDto> _formules = [];
    private PlanUsageDto? _formuleChoisie;
    private List<AbonnementHistoriqueDto> _history=[];

    protected override async Task OnInitializedAsync()
    {
        _idPartner = await Session.GetPartnerIdAsync();
        if (_idPartner is null)
        {
            Navigation.NavigateTo("/login?role=partenaire");
            return;
        }

        var (_, usage) = await PartnerApi.GetPlanUsageAsync(_idPartner.Value, Id, CancellationToken.None);
        _usage = usage;
        var (_, formules) = await PartnerApi.GetFormulesAsync(_idPartner.Value, Id, CancellationToken.None);
        _formules = formules.Where(f => f.EstActif || f.Formule == _usage?.Formule).OrderBy(f => f.OrdreAffichage).ToList();
        _history=await PartnerApi.GetHistoriqueAbonnementsAsync(_idPartner.Value,Id,CancellationToken.None);
        _checkingAuth = false;
    }

    private void SelectFormule(PlanUsageDto formule)
    {
        _formuleChoisie = formule;
        _periodicite = formule.TarifMensuel is not null ? "MENSUEL" : "ANNUEL";
        _message = null;
        _checkoutUrl = null;
    }

    private async Task SubscribeAsync()
    {
        if (_idPartner is null || _formuleChoisie is null)
        {
            return;
        }

        _busy = true;
        _message = null;
        _checkoutUrl = null;

        var (success, status, checkoutUrl) = await PartnerApi.SubscribeAsync(_idPartner.Value, Id, _formuleChoisie.Formule, _periodicite, CancellationToken.None);
        _busy = false;
        _ok = success;

        if (success)
        {
            _message = $"Abonnement créé (statut : {status}). Finalisez le paiement pour l'activer.";
            _checkoutUrl = checkoutUrl;
        }
        else
        {
            _message = status switch
            {
                "abonnement_actif_existant" => "Un abonnement actif existe déjà pour cet établissement.",
                "payment_initiation_failed" => "Le service de paiement est momentanément indisponible. Merci de réessayer.",
                "formule_non_souscriptible" => "Ce pack n'est pas disponible sur cette périodicité.",
                "formule_introuvable" => "Ce pack n'est plus disponible.",
                "forbidden" => "Cet établissement ne vous appartient pas.",
                _ => "La souscription a échoué. Merci de réessayer.",
            };
        }
    }

    private static string LimiteLabel(PlanUsageDto? formule, bool prestations)
    {
        var limite = prestations ? formule?.LimitePrestations : formule?.LimiteRdvMensuels;
        var libelle = prestations ? "prestations" : "rendez-vous par mois";
        return limite is null ? $"{libelle} illimités" : $"{limite} {libelle}";
    }

    private static string UsageLabel(PlanUsageDto usage)
    {
        var prestations = usage.LimitePrestations is null ? $"{usage.PrestationsUtilisees} prestations" : $"{usage.PrestationsUtilisees}/{usage.LimitePrestations} prestations";
        var rdv = usage.LimiteRdvMensuels is null ? $"{usage.RendezVousMoisUtilises} RDV ce mois" : $"{usage.RendezVousMoisUtilises}/{usage.LimiteRdvMensuels} RDV ce mois";
        return $"{prestations} · {rdv}";
    }
}
