@page "/partenaire/login"
@inject AuthApiClient AuthApi
@inject PartnerSessionService Session
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Connexion gérant</PageTitle>

<h1>Connexion gérant</h1>

@if (!_codeSent)
{
    <div class="mb-3">
        <label class="form-label">Numéro de téléphone (format international, ex. +2250700000000)</label>
        <input class="form-control" @bind="_telephone" />
    </div>
    <button class="btn btn-primary" @onclick="RequestOtpAsync" disabled="@_busy">Recevoir le code</button>
}
else
{
    <div class="mb-3">
        <label class="form-label">Code reçu par WhatsApp</label>
        <input class="form-control" @bind="_code" />
    </div>
    <button class="btn btn-primary" @onclick="VerifyOtpAsync" disabled="@_busy">Valider</button>
    <button class="btn btn-link" @onclick="() => _codeSent = false">Changer de numéro</button>
}

@if (!string.IsNullOrEmpty(_message))
{
    <div class="alert @(_success ? "alert-success" : "alert-danger") mt-3">@_message</div>
}

@code {
    private const int TypeComptePartenaire = 1;

    private string _telephone = "";
    private string _code = "";
    private bool _codeSent;
    private bool _busy;
    private bool _success;
    private string? _message;

    private async Task RequestOtpAsync()
    {
        _busy = true;
        var (success, status, message) = await AuthApi.RequestOtpAsync(_telephone, TypeComptePartenaire, CancellationToken.None);
        _busy = false;

        if (success)
        {
            _codeSent = true;
            _success = true;
            _message = "Code envoyé. Vérifiez WhatsApp.";
        }
        else
        {
            _success = false;
            _message = status switch
            {
                "invalid_phone" => "Numéro invalide (format international attendu).",
                "account_suspended" => "Ce compte est suspendu.",
                _ => message ?? "L'envoi du code a échoué. Merci de réessayer plus tard.",
            };
        }
    }

    private async Task VerifyOtpAsync()
    {
        _busy = true;
        var (success, status, idUtilisateur) = await AuthApi.VerifyOtpAsync(_telephone, _code, TypeComptePartenaire, CancellationToken.None);
        _busy = false;

        if (success && idUtilisateur is not null)
        {
            await Session.SetPartnerIdAsync(idUtilisateur.Value);
            Navigation.NavigateTo("/partenaire");
            return;
        }

        _success = false;
        _message = "Code invalide ou expiré. Merci de réessayer.";
    }
}
