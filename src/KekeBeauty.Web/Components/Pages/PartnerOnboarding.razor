const decimal DefaultLat=5.3599517m, DefaultLng=-4.0082563m;
 string _addressQuery=""; string? _adresseTexte,_submitStatus; List<KekeBeauty.Web.Services.GeoSuggestionDto> _addressSuggestions=[]; CancellationTokenSource? _addressCts; int _lastRenderedStep; bool _pickerDirty=true; DotNetObjectReference<PartnerOnboarding>? _pickerRef;
 string AlertTitle=>_messageSeverity switch{"warning"=>"Attention","info"=>"Information","success"=>"Terminé",_=>"Action impossible"};
 string Eyebrow=>_step switch{1=>"Votre compte",2=>"Votre activité",3=>"Où vous trouver",4=>"Vérification",_=>"Dernière étape"}; string Title=>_step switch{1=>"Commençons simplement",2=>"Présentez votre boutique",3=>"Localisation et horaires",4=>"Ajoutez vos documents",_=>"Tout est prêt ?"}; string Description=>_step switch{1=>"Google ou WhatsApp : choisissez la méthode la plus rapide.",2=>"Ces informations apparaîtront sur votre fiche publique.",3=>"Un bouton suffit pour détecter votre position.",4=>"Prenez directement les photos avec votre téléphone.",_=>"Relisez vos informations avant d’envoyer le dossier."};
 bool CanContinueIdentity=>_authChoiceMade&&!string.IsNullOrWhiteSpace(_telephone)&&(_googleConnected||_phoneVerified);
 protected override void OnInitialized()=>_googleClientId=Configuration["Authentication:Google:ClientId"];
 protected override async Task OnAfterRenderAsync(bool first){if(first){var d=await JS.InvokeAsync<Draft?>("kekeOnboarding.load");if(d is not null)Apply(d);await TryUseConnectedAccountAsync();await InvokeAsync(StateHasChanged);}if(_step==1&&!_googleConnected&&!string.IsNullOrWhiteSpace(_googleClientId)){_googleRef??=DotNetObjectReference.Create(this);await JS.InvokeAsync<bool>("kekeGoogle.render",_googleClientId,_googleRef,"partner-google-signin");}
  if(_step==3&&(_lastRenderedStep!=3||_pickerDirty)){
   var lat=_lat==0?DefaultLat:_lat; var lng=_lng==0?DefaultLng:_lng;
   _pickerRef??=DotNetObjectReference.Create(this);
   if(_lastRenderedStep!=3) await JS.InvokeVoidAsync("kekeMap.initPicker","onboarding-picker-map",lat,lng,16,_pickerRef);
   else await JS.InvokeVoidAsync("kekeMap.setPickerPosition","onboarding-picker-map",lat,lng);
   _pickerDirty=false;
  }
  _lastRenderedStep=_step;
 }
 async Task TryUseConnectedAccountAsync(){
  var partnerId=await PartnerSession.GetPartnerIdAsync();
  var token=await PartnerSession.GetTokenAsync();
  if(partnerId is null||string.IsNullOrWhiteSpace(token))return;
  var(sessionValid,unauthorized,_)=await PartnerApi.GetMesEtablissementsAsync(partnerId.Value,CancellationToken.None);
  if(!sessionValid){
   if(unauthorized){await PartnerSession.ClearAsync();_messageSeverity="warning";_message="Votre session a expiré. Reconnectez-vous pour rattacher la boutique au bon compte.";}
   return;
  }
  var profile=await PartnerApi.GetPartnerProfileAsync(partnerId.Value,CancellationToken.None);
  _partnerSessionToken=token;
  _connectedAccount=true;
  _authChoiceMade=true;
  _phoneVerified=true;
  if(!string.IsNullOrWhiteSpace(profile?.Telephone))_telephone=profile.Telephone;
  if(string.IsNullOrWhiteSpace(_contact))_contact=_telephone;
  _step=Math.Max(2,_step);
  _message=null;
 }
 [JSInvokable] public async Task ReceiveGoogleCredential(string credential){_busy=true;await InvokeAsync(StateHasChanged);var(ok,status,_,token)=await AuthApi.LoginPartnerWithGoogleAsync(credential,CancellationToken.None);_busy=false;if(ok&&token is not null){_googleConnected=true;_authChoiceMade=true;_googleToken=token;_message=null;}else {_messageSeverity="danger";_message=status=="account_suspended"?"Ce compte est suspendu.":"La connexion Google a échoué. Réessayez.";}await InvokeAsync(StateHasChanged);}
 void UsePhone(){_authChoiceMade=true;_emailAuthMode=false;_googleConnected=false;_phoneVerified=false;_otpSent=false;_googleToken=null;_partnerSessionToken=null;}
 void UseEmailPassword(){_authChoiceMade=true;_emailAuthMode=true;_emailLoginMode=false;_emailAuthStep="form";_googleConnected=false;_phoneVerified=false;_googleToken=null;_partnerSessionToken=null;} void ShowEmailLogin(){_emailLoginMode=true;_message=null;} void ShowEmailRegistration(){_emailLoginMode=false;_message=null;}
 async Task RegisterEmailPasswordAsync(){_busy=true;_message=null;var(ok,status,idUtilisateur,_)=await AuthApi.RegisterWithPasswordAsync(_emailNom,_telephone,_emailAddr,_emailPassword,1,CancellationToken.None);_busy=false;if(ok&&idUtilisateur is not null){_emailIdUtilisateur=idUtilisateur;_emailAuthStep="verify";_messageSeverity="success";_message="Code de vérification envoyé par email.";}else if(status=="email_already_used"){_emailLoginMode=true;_messageSeverity="info";_message="Ce compte existe déjà. Nous essayons de vous connecter avec le mot de passe saisi.";await LoginExistingEmailPasswordAsync();}else{_messageSeverity="danger";_message=status switch{"telephone_already_used"=>"Ce numéro est déjà associé à un compte. Choisissez J’ai déjà un compte ou utilisez WhatsApp.","invalid_phone"=>"Numéro de téléphone invalide.","invalid_email"=>"Adresse email invalide.","weak_password"=>"Le mot de passe doit contenir au moins 8 caractères.",_=>"L'inscription a échoué. Merci de réessayer."};}}
