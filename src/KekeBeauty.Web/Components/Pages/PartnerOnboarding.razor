 async Task OnAddressKeyUp(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e){
  _addressCts?.Cancel();
  if(_addressQuery.Trim().Length<3){_addressSuggestions=[];return;}
  var cts=new CancellationTokenSource(); _addressCts=cts;
  try{
   await Task.Delay(350,cts.Token);
   var results=await Geo.SearchAsync(_addressQuery,cts.Token);
   if(!cts.IsCancellationRequested){_addressSuggestions=results.ToList();await InvokeAsync(StateHasChanged);}
  }catch(TaskCanceledException){}
 }

 async Task SelectAddressAsync(KekeBeauty.Web.Services.GeoSuggestionDto suggestion){
  _lat=suggestion.Latitude; _lng=suggestion.Longitude; _adresseTexte=suggestion.DisplayName;
  _addressQuery=suggestion.DisplayName; _addressSuggestions=[]; _locationOk=true;
  _locationMessage="Position définie depuis l’adresse recherchée."; _pickerDirty=true;
  await Save();
 }

 [JSInvokable] public async Task OnPinMoved(double lat,double lng){
  _lat=(decimal)lat; _lng=(decimal)lng; _locationOk=true; _locationMessage="Position ajustée manuellement.";
  await InvokeAsync(StateHasChanged);
  await ReverseGeocodeAsync();
  await Save();
 }

 async Task ReverseGeocodeAsync(){
  if(_lat==0||_lng==0)return;
  _adresseTexte=await Geo.ReverseAsync(_lat,_lng,CancellationToken.None);
  await InvokeAsync(StateHasChanged);
 }
