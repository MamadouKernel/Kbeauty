# Run `sh scripts/init-env.sh` once: it creates .env from this file and fills the secrets below with random values.
# docker-compose.yml refuses to start while POSTGRES_PASSWORD, MINIO_ROOT_USER and MINIO_ROOT_PASSWORD are empty: the repository is
# public, so no default password may exist. Never commit a real .env. Production secrets belong in a secret manager.
POSTGRES_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# "S'y rendre" with Yango. Empty = Yango's official route link (yango.go.link): on a phone it opens the Yango app
# with the destination filled in, elsewhere Yango's web order page. `off` hides the button. A custom template
# may use {lat} and {lng}. Ask integration-support@yango.com for a partner id and change `ref=` in the template.
YANGO_URL_TEMPLATE=

# Map tiles. Empty = CARTO Voyager tiles (OpenStreetMap data) (fine for development, no uptime guarantee, and its usage
# policy discourages commercial traffic). For production use a provider such as MapTiler, Stadia Maps or Jawg:
# an https template with {z}/{x}/{y}, e.g. https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
# (restrict the key to your domain in the provider's dashboard: it is visible in the browser).
MAP_TILES_URL=
MAP_TILES_ATTRIBUTION=

# Optional first SuperAdmin (needs a password of 10+ characters with a letter and a digit,
# not containing the e-mail name). It enrols in Google Authenticator at first sign-in.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Sign in with Google: create an OAuth client (type "Web application", origin http://localhost:4200)
# in Google Cloud Console, then set both values. Leave disabled otherwise.
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=

# JWT signing key of the API. NEVER commit a real one: the repository is public. Leave empty in development for a random key that
# lasts as long as the API process (sessions end when it restarts); to keep sessions, set a stable one: openssl rand -base64 48
# In production the API refuses to start with a missing, short, placeholder or published key; keep it in the secret manager.
JWT_SIGNING_KEY=

# Redis (live updates across API instances and shared rate-limit counters): not reachable from outside the compose network, password required.
REDIS_PASSWORD=

# Grafana (supervision dashboard, profile `observability`): the administrator's password. Generated by scripts/init-env.sh.
GRAFANA_ADMIN_PASSWORD=

# Key that encrypts the Data Protection keys (which protect every TOTP secret) in the database: a copy of the database alone must not
# open the second factors. Generated by scripts/init-env.sh; in production it comes from the keystore (DataProtection__KeyEncryptionKey).
# Losing it makes the stored keys unreadable (users would have to re-enrol their authenticator): back it up like any other secret.
DATA_PROTECTION_KEK=

# Online payments. Default: the simulated gateway. To try the WiniPayer TEST sandbox (docs/DEPLOYMENT.md section 7), set the
# four values below and point PAYMENTS_PUBLIC_URL to the public address (tunnel) of this stack: WiniPayer must reach it.
PAYMENTS_PROVIDER=Fake
WINIPAY_APPLY_KEY=
WINIPAY_TOKEN=
WINIPAY_ENV=test
PAYMENTS_PUBLIC_URL=http://localhost:4200

# LeTexto (https://www.letexto.com): SMS and e-mail campaigns. Switched off for now: kept as comments, nothing reads these values
# (docker-compose.yml has the matching lines commented out). Uncomment both to bring it back.
# LETEXTO_ENABLED=false
# LETEXTO_API_KEY=
# LETEXTO_SMS_SENDER=
# LETEXTO_EMAIL_FROM=
# LETEXTO_WEBHOOK_SECRET=

# WhatsApp through Zavu (https://docs.zavu.dev): Log (default) only logs; Zavu sends Meta-approved templates (OTP, notifications).
# ZAVU_API_KEY is a secret: zv_test_... (sandbox, only reaches phones verified in the Zavu dashboard) or zv_live_... (production).
# ZAVU_SENDER_ID is optional (the WhatsApp account to use when the project has several). ZAVU_WEBHOOK_SECRET is the signing secret
# Zavu shows once when you create the webhook (URL: {PAYMENTS_PUBLIC_URL}/api/v1/webhooks/whatsapp/zavu), required in production.
WHATSAPP_PROVIDER=Log
ZAVU_API_KEY=
ZAVU_SENDER_ID=
ZAVU_WEBHOOK_SECRET=
# Sign in with a one-time code sent by WhatsApp to a linked number (needs WHATSAPP_PROVIDER=Zavu and the approved keke_otp template).
WHATSAPP_LOGIN_ENABLED=false
EMAIL_PROVIDER=LeTexto.
# LETEXTO_WEBHOOK_SECRET protects the delivery-report URL (any long random string); PAYMENTS_PUBLIC_URL must be reachable by LeTexto.
LETEXTO_ENABLED=false
LETEXTO_API_KEY=
LETEXTO_SMS_SENDER=
LETEXTO_EMAIL_FROM=
LETEXTO_WEBHOOK_SECRET=
EMAIL_PROVIDER=

# E-mail by SMTP (MailKit): account e-mails AND notifications (confirmations, reminders, cancellations).
# Defaults send to the local mailpit inbox (http://localhost:8025). For production put your relay here; SMTP_PASSWORD is a secret.
# SMTP_SECURITY: None (local), StartTls (port 587, usual) or SslOnConnect (port 465).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURITY=None
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@keke-beauty.local
SMTP_FROM_NAME=Keke Beauty

# Web Push (VAPID). Leave empty to let the API generate and keep its own key pair. To use your own: `npx web-push generate-vapid-keys`.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:contact@kekebeauty.example

# Redis backplane for several API servers (default: the redis service of docker-compose.yml). Empty disables it (single server).
REDIS_CONNECTION=redis:6379

# OpenTelemetry. Empty = off. Local viewer: `docker compose --profile observability up -d`, then OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
# and open http://localhost:16686.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Database backups (SuperAdmin > Sauvegardes). BACKUPS_SCHEDULED=true adds a nightly backup; older ones are purged after N days.
BACKUPS_SCHEDULED=false
BACKUPS_RETENTION_DAYS=14

# Maximum size of a video uploaded to an establishment page, in MB (the web proxy accepts up to 70 MB per request).
MEDIA_MAX_VIDEO_MB=50
