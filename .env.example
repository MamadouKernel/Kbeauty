# Copy to .env to override the development defaults used by docker-compose.yml.
# Never commit a real .env. Production secrets belong in a secret manager.
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me-too

# "S'y rendre" with Yango. Empty = Yango's official route link (yango.go.link): on a phone it opens the Yango app
# with the destination filled in, elsewhere Yango's web order page. `off` hides the button. A custom template
# may use {lat} and {lng}. Ask integration-support@yango.com for a partner id and change `ref=` in the template.
YANGO_URL_TEMPLATE=

# Map tiles. Empty = CARTO Voyager tiles (OpenStreetMap data) (fine for development, no uptime guarantee, and its usage
# policy discourages commercial traffic). For production use a provider such as MapTiler, Stadia Maps or Jawg:
# an https template with {z}/{x}/{y}, e.g. https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
# (restrict the key to your domain in the provider's dashboard: it is visible in the browser).
MAP_TILES_URL=
MAP_TILES_ATTRIBUTION=

# Optional first SuperAdmin (needs a password of 10+ characters with a letter and a digit,
# not containing the e-mail name). It enrols in Google Authenticator at first sign-in.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Sign in with Google: create an OAuth client (type "Web application", origin http://localhost:4200)
# in Google Cloud Console, then set both values. Leave disabled otherwise.
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=

# Online payments. Default: the simulated gateway. To try the WiniPayer TEST sandbox (docs/DEPLOYMENT.md section 7), set the
# four values below and point PAYMENTS_PUBLIC_URL to the public address (tunnel) of this stack: WiniPayer must reach it.
PAYMENTS_PROVIDER=Fake
WINIPAY_APPLY_KEY=
WINIPAY_TOKEN=
WINIPAY_ENV=test
PAYMENTS_PUBLIC_URL=http://localhost:4200

# LeTexto (https://www.letexto.com): SMS and e-mail campaigns. Everything stays log-only until LETEXTO_ENABLED=true.
# Create the API key in LeTexto (API développeur), create the SMS sender (max 11 characters) and the e-mail sender there,
# then fill the four values. To send the account e-mails through LeTexto too, set EMAIL_PROVIDER=LeTexto.
# LETEXTO_WEBHOOK_SECRET protects the delivery-report URL (any long random string); PAYMENTS_PUBLIC_URL must be reachable by LeTexto.
LETEXTO_ENABLED=false
LETEXTO_API_KEY=
LETEXTO_SMS_SENDER=
LETEXTO_EMAIL_FROM=
LETEXTO_WEBHOOK_SECRET=
EMAIL_PROVIDER=

# Web Push (VAPID). Leave empty to let the API generate and keep its own key pair. To use your own: `npx web-push generate-vapid-keys`.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:contact@kekebeauty.example

# Redis backplane for several API servers (default: the redis service of docker-compose.yml). Empty disables it (single server).
REDIS_CONNECTION=redis:6379

# OpenTelemetry. Empty = off. Local viewer: `docker compose --profile observability up -d`, then OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
# and open http://localhost:16686.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Database backups (SuperAdmin > Sauvegardes). BACKUPS_SCHEDULED=true adds a nightly backup; older ones are purged after N days.
BACKUPS_SCHEDULED=false
BACKUPS_RETENTION_DAYS=14

# Maximum size of a video uploaded to an establishment page, in MB (the web proxy accepts up to 70 MB per request).
MEDIA_MAX_VIDEO_MB=50
