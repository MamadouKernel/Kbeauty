@page "/carte"
@inject DirectoryApiClient DirectoryApi
@inject IJSRuntime JS
@rendermode InteractiveServer
@using KekeBeauty.Web.Components.Layout

<PageTitle>Keke Beauty — Carte</PageTitle>

<DesktopHeader ActivePath="carte" />

<header class="lg:hidden fixed top-0 w-full z-50 pt-safe bg-surface/80 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)]">
    <div class="h-16 px-margin flex items-center justify-between">
        <div class="flex items-center gap-space-sm">
            <img alt="Keke Beauty" class="h-8 w-auto object-contain" src="/img/logo.png" />
            <div class="flex flex-col">
                <span class="font-label-md text-label-md text-primary tracking-wide uppercase">Keke Beauty</span>
                <span class="font-headline-sm text-headline-sm text-text-primary leading-none">Carte</span>
            </div>
        </div>
        <div class="flex items-center gap-space-sm">
            <NotificationBell />
            <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center">
                <span class="material-symbols-outlined text-on-primary text-[18px]">person</span>
            </div>
        </div>
    </div>
</header>

<main id="main-content" tabindex="-1" class="flex-1 flex flex-col relative w-full pt-16 lg:pt-20 pb-24 lg:pb-0 bg-surface">
    <div class="flex flex-col w-full relative select-none">
        <div class="map-viewport relative w-full h-[calc(100vh-8rem)] lg:h-[calc(100vh-5rem)] overflow-hidden bg-surface-container">

            <div id="carte-osm" class="absolute inset-0 z-0"></div>

            <div class="absolute top-3 inset-x-0 z-30 px-margin flex flex-col gap-space-sm">
                <div class="bg-surface-cream/95 backdrop-blur-md rounded-full shadow-[0_8px_30px_rgba(58,13,82,0.12)] p-1.5 flex items-center gap-space-xs">
                    <div class="flex items-center pl-3 pr-1 text-primary">
                        <span class="material-symbols-outlined text-[20px]">search</span>
                    </div>
                    <input class="flex-1 bg-transparent text-text-primary placeholder:text-outline font-body-md text-body-md focus:outline-none min-w-0"
                           placeholder="Rechercher salon, prestation..." type="text"
                           @bind="_categorie" @bind:event="oninput" @onkeyup="OnSearchKeyUp" />
                    <button class="flex items-center gap-1 bg-lavender-subtle text-primary px-3 py-1.5 rounded-full font-label-md text-label-md shrink-0 shadow-sm active:scale-95 transition-transform" type="button" @onclick="() => _showCommuneInput = !_showCommuneInput">
                        <span class="material-symbols-outlined text-[16px] text-secondary">location_on</span>
                        <span class="truncate max-w-[90px]">@(string.IsNullOrWhiteSpace(_commune) ? "Commune" : _commune)</span>
                        <span class="material-symbols-outlined text-[14px]">expand_more</span>
                    </button>
                </div>
                @if (_showCommuneInput)
                {
                    <div class="bg-surface-cream/95 backdrop-blur-md rounded-full shadow-sm p-1.5 flex items-center gap-space-xs">
                        <input class="flex-1 bg-transparent px-3 text-text-primary font-body-md text-body-md focus:outline-none" placeholder="Ex: Cocody" @bind="_commune" @bind:event="oninput" />
                        <button class="px-3 py-1.5 rounded-full bg-primary text-on-primary font-label-sm text-label-sm shrink-0" type="button" @onclick="SearchAsync">OK</button>
                    </div>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(_locationMessage))
            {
                <div class="absolute top-20 inset-x-3 z-30 flex justify-center" role="status">
                    <div class="location-status @(_locationDenied ? "is-warning" : "")"><span class="material-symbols-outlined">@(_locationDenied ? "location_off" : "my_location")</span>@_locationMessage</div>
                </div>
            }
            <div class="absolute right-margin bottom-56 z-30 flex flex-col gap-space-sm items-center">
                <button aria-label="Recentrer la carte" class="w-11 h-11 bg-surface-cream text-primary rounded-full shadow-[0_4px_16px_rgba(58,13,82,0.12)] flex items-center justify-center active:scale-90 transition-transform" type="button" @onclick="LocateAsync" disabled="@_locating">
                    <span class="material-symbols-outlined text-[22px]">my_location</span>
                </button>
                <a href="/" class="flex items-center gap-1.5 bg-primary text-on-primary pl-3 pr-3.5 py-2.5 rounded-full shadow-[0_6px_20px_rgba(58,13,82,0.25)] font-label-sm text-label-sm active:scale-95 transition-transform">
                    <span class="material-symbols-outlined text-[16px]">format_list_bulleted</span>
                    <span>Liste</span>
                </a>
            </div>

            <div class="absolute bottom-3 inset-x-0 z-30 flex flex-col gap-space-xs">
                <div class="px-margin flex items-center justify-between text-on-primary/90 drop-shadow-sm">
                    <span class="font-label-md text-label-md text-surface-cream font-semibold tracking-wide">Salons à proximité (@_results.Count)</span>
                    @if (_results.Count > 1)
                    {
                        <span class="font-body-sm text-body-sm text-secondary-fixed-dim">Glisser pour voir →</span>
                    }
                </div>

                @if (_error)
                {
                    <div class="px-margin">
                        <div class="bg-error-container text-on-error-container rounded-xl px-space-md py-space-sm font-body-md text-body-md">
                            Le service annuaire est momentanément indisponible.
                        </div>
                    </div>
                }
                else if (_searched && _results.Count == 0)
                {
                    <div class="px-margin">
                        <div class="bg-surface-cream/95 rounded-xl px-space-md py-space-sm font-body-md text-body-md text-on-surface-variant">
                            Aucun salon ne correspond à ces critères.
                        </div>
                    </div>
                }
                else
                {
                    <div class="flex items-stretch gap-space-sm overflow-x-auto no-scrollbar px-margin pb-1 pt-0.5">
                        @foreach (var etablissement in _results)
                        {
                            <div class="w-[88vw] max-w-[340px] shrink-0 bg-surface-cream rounded-xl shadow-[0_10px_30px_rgba(58,13,82,0.15)] overflow-hidden flex flex-col">
                                <div class="relative h-28 w-full bg-lavender-subtle overflow-hidden"><img class="w-full h-full object-cover" src="@($"/media/devanture/{etablissement.IdEtablissement}")" alt="Devanture de @etablissement.NomEtablissement" loading="lazy" /></div>
                                <div class="p-3 flex flex-col justify-between flex-1 gap-space-xs">
                                    <div>
                                        <h3 class="font-headline-sm text-[16px] leading-tight text-text-primary truncate">@etablissement.NomEtablissement</h3>
                                        <p class="font-body-sm text-body-sm text-on-surface-variant flex items-center gap-1 mt-0.5">
                                            <span class="material-symbols-outlined text-[14px] text-secondary">near_me</span>
                                            <span>@etablissement.LibelleCommune</span>
                                        </p>
                                    </div>
                                    <div class="flex items-center gap-2 pt-1">
                                        <a class="flex-1 py-2 px-3 bg-lavender-subtle text-primary rounded-lg font-label-sm text-label-sm flex items-center justify-center gap-1 active:scale-95 transition-transform" href="@($"/etablissements/{etablissement.IdEtablissement}")">
                                            <span class="material-symbols-outlined text-[16px]">info</span>
                                            <span>Détails</span>
                                        </a>
                                        <a class="flex-1 py-2 px-3 bg-primary text-on-primary rounded-lg font-label-sm text-label-sm flex items-center justify-center gap-1 shadow-sm active:scale-95 transition-transform" href="@($"/etablissements/{etablissement.IdEtablissement}/rdv")">
                                            <span class="material-symbols-outlined text-[16px]">calendar_add_on</span>
                                            <span>Réserver</span>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</main>

<BottomNav ActivePath="carte-interactive" />

@code {
    // Abidjan (centre-ville) - vue par defaut tant qu'aucun etablissement n'est charge.
    private const decimal DefaultLat = 5.3599517m;
    private const decimal DefaultLng = -4.0082563m;

    private string? _categorie;
    private string? _commune;
    private bool _showCommuneInput;
    private List<EtablissementSummary> _results = [];
    private bool _searched;
    private bool _error;
    private bool _mapDirty;
    private bool _locating;
    private bool _locationDenied;
    private string? _locationMessage;
    private GeoPosition? _position;

    protected override async Task OnInitializedAsync() => await SearchAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender || _mapDirty)
        {
            _mapDirty = false;
            await RenderMapAsync();
        }
    }

    private async Task OnSearchKeyUp(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchAsync();
        }
    }

    private async Task SearchAsync()
    {
        var (success, results) = await DirectoryApi.SearchAsync(_categorie, _commune, CancellationToken.None);
        _error = !success;
        _results = results;
        _searched = true;
        _mapDirty = true;
    }

    private async Task LocateAsync()
    {
        _locating = true;
        _locationMessage = "Recherche de votre position…";
        _locationDenied = false;
        try
        {
            _position = await JS.InvokeAsync<GeoPosition>("kekeMap.getCurrentPosition");
            if (_position.Status == "granted")
            {
                _results = _results.OrderBy(x => DistanceKm(_position.Latitude, _position.Longitude, (double)x.GpsLatitude, (double)x.GpsLongitude)).ToList();
                _locationMessage = _results.Count == 0 ? "Position trouvée." : $"Salons classés du plus proche au plus éloigné.";
                await JS.InvokeVoidAsync("kekeMap.focus", "carte-osm", _position.Latitude, _position.Longitude, 14);
            }
            else
            {
                _locationDenied = true;
                _locationMessage = _position.Status == "denied" ? "Localisation refusée. Autorisez-la dans les réglages du navigateur pour voir les salons proches." : "Position indisponible. La carte reste utilisable manuellement.";
            }
        }
        catch { _locationDenied = true; _locationMessage = "Position indisponible. La carte reste utilisable manuellement."; }
        _locating = false;
    }

    private static double DistanceKm(double lat1, double lon1, double lat2, double lon2)
    {
        const double radius = 6371;
        var dLat = (lat2 - lat1) * Math.PI / 180;
        var dLon = (lon2 - lon1) * Math.PI / 180;
        var a = Math.Sin(dLat / 2) * Math.Sin(dLat / 2) + Math.Cos(lat1 * Math.PI / 180) * Math.Cos(lat2 * Math.PI / 180) * Math.Sin(dLon / 2) * Math.Sin(dLon / 2);
        return radius * 2 * Math.Atan2(Math.Sqrt(a), Math.Sqrt(1 - a));
    }

    private sealed class GeoPosition { public string Status { get; set; } = "unavailable"; public double Latitude { get; set; } public double Longitude { get; set; } public double Accuracy { get; set; } }
    private async Task RenderMapAsync()
    {
        var centerLat = _results.Count > 0 ? _results.Average(r => r.GpsLatitude) : DefaultLat;
        var centerLng = _results.Count > 0 ? _results.Average(r => r.GpsLongitude) : DefaultLng;

        var markers = _results.Select(r => new
        {
            lat = r.GpsLatitude,
            lng = r.GpsLongitude,
            popupHtml = $"<strong>{System.Net.WebUtility.HtmlEncode(r.NomEtablissement)}</strong><br/>{System.Net.WebUtility.HtmlEncode(r.LibelleCommune)}<br/><a href=\"/etablissements/{r.IdEtablissement}\">Voir le salon</a>",
        });

        await JS.InvokeVoidAsync("kekeMap.init", "carte-osm", centerLat, centerLng, _results.Count > 0 ? 12 : 11, markers);
    }
}

