# PostgreSQL (Docker Desktop)
POSTGRES_USER=kekebeauty
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kekebeautyDb
POSTGRES_PORT=5432

# pgAdmin (optionnel, interface d'administration de la BD)
PGADMIN_EMAIL=admin@kekebeauty.example.com
PGADMIN_PASSWORD=change-me
PGADMIN_PORT=5050

# API backend (.NET)
API_PORT=5080

# Frontend web (.NET Blazor)
WEB_PORT=5090

# Zavu (OTP WhatsApp) - laisser vide tant que le projet Zavu Keke Beauty n'est pas configure
ZAVU_API_KEY=

# Compte super-admin initial (cree uniquement si aucun compte admin n'existe encore)
ADMIN_EMAIL=admin@kekebeauty.ci
ADMIN_API_KEY=change-me
# Secret persistant de signature des sessions admin (long, aleatoire et distinct du mot de passe)
ADMIN_SIGNING_KEY=change-me-with-at-least-32-random-characters
# Signature persistante des sessions client/partenaire (32 caracteres minimum)
SESSION_SIGNING_KEY=use-another-long-random-secret-here

# WiniPayer (agregateur de paiement abonnement, feature 008) - voir https://manager.winipayer.com
WINIPAYER_ENV=test
WINIPAYER_MERCHANT_APPLY=
WINIPAYER_TEST_TOKEN_KEY=
WINIPAYER_TEST_PRIVATE_KEY=
WINIPAYER_PROD_TOKEN_KEY=
WINIPAYER_PROD_PRIVATE_KEY=

# Wave Business API : remboursements et reversements de pourboires
WAVE_API_BASE_URL=https://api.wave.com/
WAVE_API_KEY=
WAVE_SIGNING_SECRET=
