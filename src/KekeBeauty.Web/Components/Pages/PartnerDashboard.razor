@page "/partenaire"
@inject PartnerApiClient PartnerApi
@inject PartnerSessionService Session
@inject NavigationManager Navigation
@* prerender:false : la session (ProtectedLocalStorage) n'est lisible qu'apres l'attache du
   circuit interactif - la lire pendant le prerender statique echoue silencieusement et provoque
   une redirection immediate vers login (bug decouvert lors des tests reels de 012). *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Mes établissements</PageTitle>
@using KekeBeauty.Web.Components.Layout

<PartnerDesktopHeader ActivePath="salons" />

<header class="lg:hidden fixed top-0 inset-x-0 z-50 bg-surface/90 backdrop-blur-xl shadow-[0_1px_8px_rgba(58,13,82,0.04)] pt-safe">
    <div class="h-16 px-margin flex items-center justify-between gap-space-sm">
        <div class="flex items-center gap-space-sm">
            <img alt="Keke Beauty" class="h-8 w-auto object-contain" src="/img/logo.png" />
            <div class="flex flex-col">
                <span class="font-label-md text-label-md text-primary tracking-wide uppercase">Keke Beauty</span>
                <span class="font-headline-sm text-headline-sm text-text-primary leading-none">Espace partenaire</span>
            </div>
        </div>
    </div>
</header>

<main id="main-content" tabindex="-1" class="flex flex-col relative w-full pt-16 lg:pt-24 pb-24 bg-surface min-h-screen">
    <div class="flex flex-col w-full px-margin pb-10 space-y-space-lg lg:max-w-5xl lg:mx-auto">

        @if (_checkingAuth)
        {
            <p class="font-body-md text-body-md text-on-surface-variant pt-space-md">Chargement…</p>
        }
        else if (_error)
        {
            <div class="rounded-xl bg-error-container text-on-error-container px-space-md py-space-sm font-body-md text-body-md mt-space-md">
                Le service est momentanément indisponible. Merci de réessayer.
            </div>
        }
        else
        {
            <section class="partner-hero mt-space-md mb-6">
                <div class="partner-hero-glow" aria-hidden="true"></div>
                <div class="relative z-10">
                    <p class="font-label-sm text-label-sm uppercase tracking-[0.18em] partner-hero-eyebrow mb-1">Espace partenaire</p>
                    <h1 class="font-headline-lg text-headline-lg text-white font-bold partner-hero-title">Mes établissements</h1>
                    @if (_etablissements.Count > 0)
                    {
                        <p class="font-body-sm text-body-sm partner-hero-sub mt-1">@_etablissements.Count @(_etablissements.Count > 1 ? "boutiques rattachées" : "boutique rattachée") · @_etablissements.Count(e => e.StatutKyc == "VALIDE") validée@(_etablissements.Count(e => e.StatutKyc == "VALIDE") > 1 ? "s" : "")</p>
                    }
                </div>
            </section>

            @if (_etablissements.Any(e => e.StatutKyc == "VALIDE"))
            {
                <KekeAlert Severity="success" Title="Validation Keke Beauty confirmée">Votre boutique vérifiée est visible par les clientes. Ouvrez-la pour consulter sa fiche publique et compléter les informations qui améliorent les réservations.</KekeAlert>
            }
            else if (_etablissements.Any(e => e.StatutKyc == "EN_ATTENTE"))
            {
                <KekeAlert Severity="info" Title="Vérification en cours">Vous pouvez déjà configurer vos prestations, horaires, équipe et tarifs. Nous afficherons ici la confirmation dès la validation.</KekeAlert>
            }

            @if (_etablissements.Count == 0)
            {
                <section class="text-center py-space-lg bg-surface-cream rounded-3xl shadow-[0_20px_50px_-30px_rgba(58,13,82,0.35)] px-space-md border border-outline-variant/40">
                    <div class="w-20 h-20 mx-auto rounded-full bg-gradient-to-br from-lavender-subtle to-surface-container flex items-center justify-center shadow-inner">
                        <span class="material-symbols-outlined text-[38px] text-primary" aria-hidden="true">add_business</span>
                    </div>
                    <h2 class="font-headline-md text-headline-md text-text-primary mt-4">Aucune boutique rattachée</h2>
                    <p class="font-body-md text-body-md text-on-surface-variant mt-2 max-w-md mx-auto">Créez votre dossier boutique avec le même compte Google. Le rattachement sera automatique.</p>
                    <a class="inline-flex items-center gap-2 mt-5 px-6 py-3 rounded-full bg-primary-container text-white font-bold shadow-md hover:brightness-105 transition-all" href="/partenaire/inscription">
                        <span class="material-symbols-outlined text-[20px]">add</span>Créer et rattacher ma boutique
                    </a>
                </section>
            }
            else
            {
                <div class="grid gap-space-md sm:grid-cols-2">
                    @foreach (var etablissement in _etablissements)
                    {
                        <a class="partner-shop-card" href="@($"/partenaire/etablissements/{etablissement.IdEtablissement}")">
                            <div class="partner-shop-card-thumb">
                                <img src="@($"/media/devanture/{etablissement.IdEtablissement}")" alt="Devanture de @etablissement.NomEtablissement" loading="lazy" />
                            </div>
                            <div class="flex items-center justify-between gap-space-sm p-space-md">
                                <div class="min-w-0">
                                    <p class="font-label-lg text-label-lg text-text-primary font-bold truncate">@etablissement.NomEtablissement</p>
                                    <div class="flex items-center gap-1.5 mt-1.5 flex-wrap">
                                        <span class="font-label-sm text-label-sm px-2.5 py-1 rounded-full @KycBadgeClass(etablissement.StatutKyc)">KYC : @KycLabel(etablissement.StatutKyc)</span>
                                        @if (etablissement.EstSuspendu)
                                        {
                                            <span class="font-label-sm text-label-sm px-2.5 py-1 rounded-full bg-error-container text-on-error-container">Suspendu</span>
                                        }
                                    </div>
                                </div>
                                <span class="partner-shop-card-arrow"><span class="material-symbols-outlined text-[18px]">arrow_forward</span></span>
                            </div>
                        </a>
                    }
                </div>
            }
        }
    </div>
</main>

@code {
    private bool _checkingAuth = true;
    private bool _error;
    private List<EtablissementGere> _etablissements = [];

    protected override async Task OnInitializedAsync()
    {
        var idPartner = await Session.GetPartnerIdAsync();
        if (idPartner is null)
        {
            Navigation.NavigateTo("/login?role=partenaire");
            return;
        }

        if (await Session.GetTokenAsync() is null)
        {
            await Session.ClearAsync();
            Navigation.NavigateTo("/login?role=partenaire&session=missing_token", forceLoad: true);
            return;
        }

        var (success, unauthorized, etablissements) = await PartnerApi.GetMesEtablissementsAsync(idPartner.Value, CancellationToken.None);
        if (unauthorized)
        {
            await Session.ClearAsync();
            Navigation.NavigateTo("/login?role=partenaire&session=unauthorized", forceLoad: true);
            return;
        }
        _error = !success;
        _etablissements = etablissements;
        _checkingAuth = false;
    }

    private static string KycLabel(string statut) => statut switch
    {
        "VALIDE" => "Validé",
        "EN_ATTENTE" => "En attente",
        "REJETE" => "Rejeté",
        _ => statut,
    };

    private static string KycBadgeClass(string statut) => statut switch
    {
        "VALIDE" => "bg-status-available/15 text-status-available",
        "REJETE" => "bg-error-container text-on-error-container",
        _ => "bg-lavender-subtle text-primary",
    };
}
