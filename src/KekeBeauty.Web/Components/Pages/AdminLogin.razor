@page "/admin/login"
@inject AdminApiClient AdminApi
@inject AdminSessionService Session
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Connexion admin</PageTitle>

<main id="main-content" tabindex="-1" class="admin-login admin-legacy"><div class="admin-login-card">
<a class="brand" href="/"><img src="/img/logo.png" alt="" /><span>Keke Beauty<small>ESPACE ADMINISTRATION</small></span></a>
<h1>Connexion admin</h1>

<div class="mb-3">
    <label for="admin-email" class="form-label">Adresse e-mail</label>
    <input id="admin-email" autocomplete="username" class="form-control" type="email" @bind="_email" />
</div><div class="mb-3">
    <label for="admin-password" class="form-label">Mot de passe</label>
    <input id="admin-password" autocomplete="current-password" class="form-control" type="password" @bind="_password" />
</div>
<button class="btn btn-primary" @onclick="LoginAsync" disabled="@_busy">Se connecter</button>

<ToastBridge Message="@_message" Severity="danger" OnShown="@(() => _message = null)" />

</div></main>

@code {
    [SupplyParameterFromQuery]
    public bool Expired { get; set; }

    private string _email = "admin@kekebeauty.ci";
    private string _password = "";
    private bool _busy;
    private string? _message;

    protected override void OnInitialized()
    {
        if (Expired) _message = "Votre session administrateur a expiré après 30 minutes d’inactivité.";
    }

    private async Task LoginAsync()
    {
        if (string.IsNullOrWhiteSpace(_email) || string.IsNullOrWhiteSpace(_password))
        {
            return;
        }

        _busy = true;
        var (valid, token, role) = await AdminApi.LoginAsync(_email, _password, CancellationToken.None);
        _busy = false;

        if (valid)
        {
            await Session.SetApiKeyAsync(token!, role);
            Navigation.NavigateTo("/admin/dossiers");
            return;
        }

        _message = "E-mail ou mot de passe invalide, ou service momentanément indisponible.";
    }
}
