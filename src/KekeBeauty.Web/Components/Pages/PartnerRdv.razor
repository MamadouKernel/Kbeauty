@page "/partenaire/etablissements/{Id:guid}/rdv"
@using KekeBeauty.Web.Components.Layout
@inject PartnerRdvApiClient PartnerRdvApi
@inject PartnerApiClient PartnerApi
@inject PartnerSessionService Session
@inject NavigationManager Navigation
@inject ToastService Toast
@rendermode @(new InteractiveServerRenderMode(prerender:false))
<PageTitle>Agenda & accueil</PageTitle>
<PartnerDesktopHeader ActivePath="rdv" IdEtablissement="Id" />
<main id="main-content" class="premium-page pb-28"><div class="premium-container">
 <div class="premium-heading split"><div><span class="premium-eyebrow">Pilotage du salon</span><h1>Agenda & accueil</h1><p>Organisez les fauteuils, traitez les demandes et ajoutez les clientes reçues au comptoir.</p></div><div class="heading-actions"><a class="premium-primary-compact secondary" href="@($"/partenaire/etablissements/{Id}/scanner")"><span class="material-symbols-outlined">qr_code_scanner</span>Scanner</a><button class="premium-primary-compact" @onclick='()=>_view="accueil"'><span class="material-symbols-outlined">person_add</span>Nouveau passage</button></div></div>
 <nav class="segmented-tabs" aria-label="Vues agenda"><button class="@Tab("agenda")" @onclick='()=>_view="agenda"'>Agenda</button><button class="@Tab("demandes")" @onclick='()=>_view="demandes"'>Demandes <span>@PendingCount</span></button><button class="@Tab("accueil")" @onclick='()=>_view="accueil"'>Accueil comptoir</button></nav>
 @if(_checkingAuth){<div class="premium-loading">Chargement de l’agenda…</div>}
 else if(_error){<KekeAlert Severity="danger" Title="Agenda indisponible">Le service ne répond pas. Réessayez dans quelques instants.</KekeAlert>}
 else if(_view=="accueil"){
  <section class="premium-card walkin-panel"><div class="premium-heading compact"><span class="premium-eyebrow">Sans rendez-vous</span><h2>Enregistrer une cliente au comptoir</h2><p>La réservation est immédiatement confirmée et apparaît dans le planning.</p></div>
   <div class="walkin-grid">
    <label class="walkin-field"><span><span class="material-symbols-outlined">person</span>Nom de la cliente</span><input class="onboarding-input" @bind="_walkinName"/></label>
    <label class="walkin-field"><span><span class="material-symbols-outlined">call</span>Téléphone</span><input class="onboarding-input" type="tel" placeholder="+225 07 00 00 00 00" @bind="_walkinPhone"/></label>
    <label class="walkin-field"><span><span class="material-symbols-outlined">content_cut</span>Prestation</span><select class="onboarding-input" @bind="_walkinService"><option value="">Choisir</option>@foreach(var p in _services){<option value="@p.IdPrestation">@p.LibellePrestation · @p.Tarif.ToString("N0") FCFA</option>}</select></label>
    <label class="walkin-field"><span><span class="material-symbols-outlined">groups</span>Collaboratrice / fauteuil</span><select class="onboarding-input" @bind="_walkinStaff"><option value="">À assigner plus tard</option>@foreach(var c in _equipe){<option value="@c.IdCollaborateur">@c.Nom</option>}</select></label>
    <label class="walkin-field"><span><span class="material-symbols-outlined">event</span>Date et heure</span><input class="onboarding-input" type="datetime-local" @bind="_walkinDate"/></label>
    <label class="walkin-field"><span><span class="material-symbols-outlined">payments</span>Règlement</span><select class="onboarding-input" @bind="_walkinPayment"><option value="ESPECES">Espèces</option><option value="EN_LIGNE">Mobile Money</option></select></label>
   </div>
   <button class="premium-primary-action" disabled="@_busy" @onclick="CreateWalkInAsync"><span class="material-symbols-outlined">add_task</span>@(_busy?"Enregistrement…":"Ajouter au planning")</button>
  </section>
 } else if(_view=="agenda"){
  <section class="agenda-toolbar"><button @onclick="PreviousPeriod"><span class="material-symbols-outlined">chevron_left</span></button><input type="date" @bind="_selectedDate"/><button @onclick="NextPeriod"><span class="material-symbols-outlined">chevron_right</span></button><button class="today" @onclick="Today">Aujourd’hui</button>@if(_periodMode=="semaine"){<span class="period-range">@WeekDays.First().ToString("d MMM",Fr) – @WeekDays.Last().ToString("d MMM",Fr)</span>}<div class="period-toggle"><button class="@(_periodMode=="jour"?"active":"")" @onclick='()=>_periodMode="jour"'>Jour</button><button class="@(_periodMode=="semaine"?"active":"")" @onclick='()=>_periodMode="semaine"'>Semaine</button></div></section>
  @if(_periodMode=="jour")
  {
   <section class="agenda-board"><aside class="agenda-hours">@foreach(var hour in Hours){<span>@hour.ToString("00"):00</span>}</aside><div class="agenda-columns">@foreach(var lane in Lanes){<article class="agenda-lane"><header>@if(lane.Id is null){<span class="agenda-lane-avatar unassigned"><span class="material-symbols-outlined" style="font-size:16px">event_seat</span></span>}else{<span class="agenda-lane-avatar" style="background:@AvatarColor(lane.Name)">@Initials(lane.Name)</span>}<strong>@lane.Name</strong></header><div class="agenda-timeline">@if(_selectedDate.Date==DateTime.Today){<div class="agenda-now-line" style="top:@(NowOffsetPx)px"></div>}@foreach(var hour in Hours){<i></i>}@foreach(var rdv in DayRdvs.Where(x=>x.IdCollaborateur==lane.Id)){<button class="agenda-event @EventClass(rdv)" style="@EventStyle(rdv)" title="@rdv.LibellePrestation" @onclick='()=>OpenRequest(rdv)'><strong>@rdv.DateHeureDebut.ToLocalTime().ToString("HH:mm") · @rdv.NomClient</strong><span>@rdv.LibellePrestation</span><small>@(rdv.OrigineRdv=="COMPTOIR"?"Comptoir":"En ligne") · @rdv.DureeMinutes min @if(rdv.RetardMinutes is not null){<b>· Retard +@rdv.RetardMinutes min</b>}</small></button>}</div></article>}</div></section>
  }
  else
  {
   <section class="agenda-board"><aside class="agenda-hours">@foreach(var hour in Hours){<span>@hour.ToString("00"):00</span>}</aside><div class="agenda-columns">@foreach(var day in WeekDays){<article class="agenda-lane @(day==DateTime.Today?"is-today":"")"><header><strong>@day.ToString("ddd d MMM",Fr)</strong></header><div class="agenda-timeline">@if(day==DateTime.Today){<div class="agenda-now-line" style="top:@(NowOffsetPx)px"></div>}@foreach(var hour in Hours){<i></i>}@foreach(var (rdv,col,cols) in LayoutDayEvents(_rdvs.Where(x=>x.DateHeureDebut.ToLocalTime().Date==day&&x.StatutRdv is "DEMANDE" or "CONFIRME"))){<button class="agenda-event @EventClass(rdv)" style="@WeekEventStyle(rdv,col,cols)" title="@rdv.LibellePrestation" @onclick='()=>OpenRequest(rdv)'><strong>@rdv.DateHeureDebut.ToLocalTime().ToString("HH:mm") · @rdv.NomClient</strong><span>@rdv.LibellePrestation</span><small>@(rdv.OrigineRdv=="COMPTOIR"?"Comptoir":"En ligne") · @rdv.DureeMinutes min</small></button>}</div></article>}</div></section>
  }
 } else {
  <section class="request-grid">@foreach(var rdv in _rdvs.Where(x=>x.StatutRdv=="DEMANDE")){<article class="request-card"><div><span class="request-time">@rdv.DateHeureDebut.ToLocalTime().ToString("ddd d MMM · HH:mm",Fr)</span><h2>@rdv.NomClient</h2><p>@rdv.LibellePrestation · @rdv.DureeMinutes min</p>@if(rdv.RetardMinutes is not null){<KekeAlert Severity="warning" Title="Retard signalé">La cliente prévoit environ @rdv.RetardMinutes minutes de retard.</KekeAlert>}<a href="tel:@rdv.TelephoneClient">@rdv.TelephoneClient</a></div><div class="request-actions"><button class="accept" @onclick="()=>ConfirmAsync(rdv.IdRdv)">Confirmer</button><button class="decline" @onclick="()=>DeclineAsync(rdv.IdRdv)">Refuser</button><button @onclick="()=>StartReschedule(rdv)">Reprogrammer</button></div>@if(_rescheduleId==rdv.IdRdv){<div class="reschedule"><input type="datetime-local" @bind="_rescheduleDate"/><button @onclick="()=>RescheduleAsync(rdv.IdRdv)">Valider</button></div>}</article>}</section>
  @if(PendingCount==0){<div class="premium-empty"><span class="material-symbols-outlined">task_alt</span><h2>Tout est traité</h2><p>Aucune demande en attente.</p></div>}
 }
</div></main>
@code{
 [Parameter]public Guid Id{get;set;} Guid? _partner;List<RdvPartenaire> _rdvs=[];List<CollaborateurDto> _equipe=[];List<PrestationDto> _services=[];bool _checkingAuth=true,_error,_busy;string _view="agenda",_periodMode="jour",_walkinName="",_walkinPhone="",_walkinService="",_walkinStaff="",_walkinPayment="ESPECES";DateTime _selectedDate=DateTime.Today,_walkinDate=DateTime.Now.AddMinutes(15),_rescheduleDate;Guid? _rescheduleId;static readonly System.Globalization.CultureInfo Fr=System.Globalization.CultureInfo.GetCultureInfo("fr-FR");IEnumerable<int> Hours=>Enumerable.Range(8,13);int PendingCount=>_rdvs.Count(x=>x.StatutRdv=="DEMANDE");IEnumerable<RdvPartenaire> DayRdvs=>_rdvs.Where(x=>x.DateHeureDebut.ToLocalTime().Date==_selectedDate.Date&&x.StatutRdv is "DEMANDE" or "CONFIRME");IEnumerable<(Guid? Id,string Name)> Lanes=>_equipe.Select(x=>((Guid?)x.IdCollaborateur,x.Nom)).Prepend((null,"Non assignés"));
 List<DateTime> WeekDays{get{var d=_selectedDate.Date;var diff=((int)d.DayOfWeek+6)%7;var monday=d.AddDays(-diff);return Enumerable.Range(0,7).Select(i=>monday.AddDays(i)).ToList();}}
 protected override async Task OnInitializedAsync(){_partner=await Session.GetPartnerIdAsync();if(_partner is null){Navigation.NavigateTo("/login?role=partenaire");return;}await LoadAsync();var(_,team)=await PartnerApi.GetEquipeAsync(_partner.Value,Id,CancellationToken.None);_equipe=team;var(_,detail)=await PartnerApi.GetDetailAsync(_partner.Value,Id,CancellationToken.None);_services=detail?.Prestations??[];_checkingAuth=false;}
 async Task LoadAsync(){var(ok,items)=await PartnerRdvApi.ListAsync(_partner!.Value,Id,CancellationToken.None);_error=!ok;_rdvs=items;}
 async Task CreateWalkInAsync(){if(!Guid.TryParse(_walkinService,out var service)||string.IsNullOrWhiteSpace(_walkinName)||string.IsNullOrWhiteSpace(_walkinPhone)){Toast.ShowError("Complétez le nom, le téléphone et la prestation.");return;}_busy=true;Guid? staff=Guid.TryParse(_walkinStaff,out var st)?st:null;var(ok,status)=await PartnerRdvApi.CreerComptoirAsync(_partner!.Value,Id,service,staff,_walkinName,_walkinPhone,new DateTimeOffset(_walkinDate),_walkinPayment,CancellationToken.None);_busy=false;if(ok){Toast.ShowSuccess("La cliente a été ajoutée au planning.");_walkinName="";_walkinPhone="";await LoadAsync();_selectedDate=_walkinDate.Date;_view="agenda";}else{Toast.ShowError(status=="creneau_indisponible"?"Ce créneau est déjà occupé.":"Impossible d’ajouter cette cliente.");}}
 async Task ConfirmAsync(Guid id){var(ok,_)=await PartnerRdvApi.ConfirmerAsync(_partner!.Value,Id,id,CancellationToken.None);if(ok){Toast.ShowSuccess("Rendez-vous confirmé.");await LoadAsync();}else{Toast.ShowError("La demande n’a pas pu être confirmée.");}}async Task DeclineAsync(Guid id){var(ok,_)=await PartnerRdvApi.RefuserAsync(_partner!.Value,Id,id,CancellationToken.None);if(ok){Toast.ShowSuccess("Demande refusée.");await LoadAsync();}else{Toast.ShowError("La demande n’a pas pu être refusée.");}}void StartReschedule(RdvPartenaire r){_rescheduleId=r.IdRdv;_rescheduleDate=r.DateHeureDebut.LocalDateTime;}async Task RescheduleAsync(Guid id){var(ok,status)=await PartnerRdvApi.ReprogrammerAsync(_partner!.Value,Id,id,new DateTimeOffset(_rescheduleDate),CancellationToken.None);if(ok){Toast.ShowSuccess("Rendez-vous reprogrammé.");_rescheduleId=null;await LoadAsync();}else{Toast.ShowError(status=="slot_unavailable_or_not_found"?"Ce créneau est indisponible.":"Reprogrammation impossible.");}}
 void PreviousPeriod()=>_selectedDate=_selectedDate.AddDays(_periodMode=="semaine"?-7:-1);void NextPeriod()=>_selectedDate=_selectedDate.AddDays(_periodMode=="semaine"?7:1);void Today()=>_selectedDate=DateTime.Today;void OpenRequest(RdvPartenaire r){if(r.StatutRdv=="DEMANDE")_view="demandes";}string Tab(string name)=>_view==name?"active":"";static string EventClass(RdvPartenaire r)=>r.StatutRdv=="DEMANDE"?"pending":r.OrigineRdv=="COMPTOIR"?"walkin":"confirmed";static string EventStyle(RdvPartenaire r){var local=r.DateHeureDebut.ToLocalTime();var top=Math.Max(0,(local.Hour-8)*60+local.Minute);var height=Math.Max(44,(int)r.DureeMinutes);return $"top:{top}px;height:{height}px";}
 static int NowOffsetPx=>Math.Clamp((DateTime.Now.Hour-8)*60+DateTime.Now.Minute,0,780);
 static List<(RdvPartenaire Rdv,int Col,int Cols)> LayoutDayEvents(IEnumerable<RdvPartenaire> items){var sorted=items.OrderBy(r=>r.DateHeureDebut).ToList();var colEnds=new List<DateTimeOffset>();var placements=new List<(RdvPartenaire,int)>();foreach(var r in sorted){var start=r.DateHeureDebut;var end=r.DateHeureDebut.AddMinutes(r.DureeMinutes);var col=-1;for(var i=0;i<colEnds.Count;i++){if(colEnds[i]<=start){col=i;break;}}if(col==-1){col=colEnds.Count;colEnds.Add(end);}else{colEnds[col]=end;}placements.Add((r,col));}var totalCols=Math.Max(1,colEnds.Count);return placements.Select(p=>(p.Item1,p.Item2,totalCols)).ToList();}
 static string WeekEventStyle(RdvPartenaire r,int col,int totalCols){var local=r.DateHeureDebut.ToLocalTime();var top=Math.Max(0,(local.Hour-8)*60+local.Minute);var height=Math.Max(30,(int)r.DureeMinutes);var widthPct=100.0/totalCols;var leftPct=col*widthPct;return $"top:{top}px;height:{height}px;left:calc({leftPct.ToString(System.Globalization.CultureInfo.InvariantCulture)}% + 2px);width:calc({widthPct.ToString(System.Globalization.CultureInfo.InvariantCulture)}% - 4px)";}
 static readonly string[] AvatarPalette=["#6b1786","#9c42f4","#0288d1","#00897b","#c2185b","#f57c00"];
 static string AvatarColor(string name)=>AvatarPalette[(uint)name.GetHashCode()%(uint)AvatarPalette.Length];
 static string Initials(string name){var parts=name.Split(' ',StringSplitOptions.RemoveEmptyEntries);if(parts.Length>=2)return $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant();return name.Length>=2?name[..2].ToUpperInvariant():name.ToUpperInvariant();}
}