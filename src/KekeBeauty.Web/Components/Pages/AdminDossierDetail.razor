@page "/admin/dossiers/{Id:guid}"
@inject AdminApiClient AdminApi
@inject AdminSessionService Session
@inject NavigationManager Navigation
@* prerender:false : voir AdminDossiers.razor pour le detail du bug de prerendering evite. *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Dossier KYC</PageTitle>
@using KekeBeauty.Web.Components.Layout
<AdminHeader ActivePath="/admin/dossiers" />
<main id="main-content" tabindex="-1" class="admin-page admin-legacy"><div class="admin-content">


@if (_checkingAuth)
{
    <p>Chargement…</p>
}
else if (_error)
{
    <div class="alert alert-danger">Le service est momentanément indisponible. Merci de réessayer.</div>
}
else if (_dossier is null)
{
    <div class="alert alert-warning">Dossier introuvable.</div>
}
else
{
    <div class="flex items-start justify-between gap-3 flex-wrap">
        <div><h1>@_dossier.NomEtablissement</h1><p>Dossier créé le @_dossier.DateCreation.ToLocalTime().ToString("dd/MM/yyyy à HH:mm")</p></div>
        <span class="kyc-status-badge @StatusClass(_dossier.StatutKyc)">@StatusLabel(_dossier.StatutKyc)</span>
    </div>

    @if (_dossier.StatutKyc == "VALIDE")
    {
        <section class="kyc-decision-summary is-approved" role="status">
            <span class="material-symbols-outlined" aria-hidden="true">verified</span>
            <div>
                <h2>Boutique vérifiée et publiée</h2>
                <p>@_dossier.NomEtablissement est maintenant visible dans l’annuaire Keke Beauty et peut recevoir des demandes de rendez-vous.</p>
                <ul><li>Badge de vérification activé pour le partenaire</li><li>Fiche publique accessible aux clientes</li><li>Réservations et fonctionnalités autorisées selon son abonnement</li></ul>
                @if (_decisionAt is not null) { <small>Validation confirmée le @_decisionAt.Value.ToLocalTime().ToString("dd/MM/yyyy à HH:mm").</small> }
                <a class="btn btn-success mt-2" href="@($"/etablissements/{Id}")">Voir la fiche publique</a>
            </div>
        </section>
    }
    else if (_dossier.StatutKyc == "REJETE")
    {
        <KekeAlert Severity="danger" Title="Dossier à corriger">La boutique n’est pas publiée. Le partenaire peut remplacer ses documents depuis son espace puis renvoyer le dossier.</KekeAlert>
    }
    <p>Numéro service client : @_dossier.NumeroServiceClient</p>
    <p>Position : @_dossier.GpsLatitude, @_dossier.GpsLongitude</p>
    <p>
        Photo devanture : @(_dossier.HasPhotoDevanture ? "fournie" : "manquante") —
        Document : @(_dossier.TypeDocumentIdentite ?? "non précisé") — recto/page d'identification : @(_dossier.HasDocumentRecto ? "fourni" : "manquant") @if (_dossier.TypeDocumentIdentite == "CNI") { <text>— verso : @(_dossier.HasDocumentVerso ? "fourni" : "manquant")</text> }
    </p>

    <section class="kyc-preview-grid" aria-label="Documents soumis">
        @if (_devantureDataUrl is not null)
        {
            <article class="kyc-preview-card"><h2>Photo de devanture</h2><img src="@_devantureDataUrl" alt="Devanture de @_dossier.NomEtablissement" /></article>
        }
        @if (_rectoDataUrl is not null)
        {
            <article class="kyc-preview-card"><h2>@(_dossier.TypeDocumentIdentite == "PASSEPORT" ? "Page d’identification du passeport" : "Recto de la pièce d’identité")</h2>@if (_rectoContentType == "application/pdf") { <object data="@_rectoDataUrl" type="application/pdf"><p>Aperçu PDF indisponible dans ce navigateur.</p></object> } else { <img src="@_rectoDataUrl" alt="Recto ou page d’identification" /> }</article>
        }
        @if (_versoDataUrl is not null)
        {
            <article class="kyc-preview-card"><h2>Verso de la pièce d’identité</h2>@if (_versoContentType == "application/pdf") { <object data="@_versoDataUrl" type="application/pdf"><p>Aperçu PDF indisponible dans ce navigateur.</p></object> } else { <img src="@_versoDataUrl" alt="Verso de la pièce d’identité" /> }</article>
        }
    </section>

    @if (_dossier.StatutKyc == "EN_ATTENTE")
    {
        <KekeAlert Severity="warning" Title="Décision KYC">Vérifiez la lisibilité, la concordance des informations et la présence de toutes les faces avant de valider.</KekeAlert>
        <button class="btn btn-success" disabled="@_busy" @onclick="ValiderAsync">@(_busy ? "Validation en cours…" : "Valider et publier la boutique")</button>
        <div class="mt-3"><textarea class="form-control" rows="2" placeholder="Motif précis du rejet, visible par le partenaire" @bind="_motifRejet"></textarea><button class="btn btn-outline-danger mt-2" disabled="@(_busy || string.IsNullOrWhiteSpace(_motifRejet))" @onclick="RejeterAsync">Rejeter et demander une correction</button></div>
    }

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <KekeAlert Severity="@(_success ? "success" : "danger")" Title="@(_success ? "Action enregistrée" : "Action impossible")">@_message</KekeAlert>
    }
}

</div></main>

@code {
    private string _motifRejet = "";
    [Parameter] public Guid Id { get; set; }

    private string? _apiKey;
    private ApplicationDetail? _dossier;
    private bool _checkingAuth = true;
    private bool _error;
    private bool _success;
    private bool _busy;
    private string? _message;
    private DateTimeOffset? _decisionAt;
    private string? _devantureDataUrl, _rectoDataUrl, _versoDataUrl, _rectoContentType, _versoContentType;

    protected override async Task OnInitializedAsync()
    {
        _apiKey = await Session.GetApiKeyAsync();
        if (_apiKey is null)
        {
            Navigation.NavigateTo("/admin/login");
            return;
        }

        await LoadAsync();
        _checkingAuth = false;
    }

    private async Task LoadAsync()
    {
        var (success, detail) = await AdminApi.GetDossierAsync(_apiKey!, Id, CancellationToken.None);
        _error = !success;
        _dossier = detail;
        if (detail is not null)
        {
            var devanture = detail.HasPhotoDevanture ? await AdminApi.GetDossierFilePreviewAsync(_apiKey!, Id, "devanture", CancellationToken.None) : default;
            var recto = detail.HasDocumentRecto ? await AdminApi.GetDossierFilePreviewAsync(_apiKey!, Id, "document-recto", CancellationToken.None) : default;
            var verso = detail.HasDocumentVerso ? await AdminApi.GetDossierFilePreviewAsync(_apiKey!, Id, "document-verso", CancellationToken.None) : default;
            _devantureDataUrl = devanture.DataUrl;
            _rectoDataUrl = recto.DataUrl;
            _rectoContentType = recto.ContentType;
            _versoDataUrl = verso.DataUrl;
            _versoContentType = verso.ContentType;
        }
    }

    private async Task ValiderAsync()
    {
        if (_busy) return;
        _busy = true; _message = null;
        try
        {
            var (success, status) = await AdminApi.ValiderDossierAsync(_apiKey!, Id, CancellationToken.None);
            _success = success;
            _message = success
                ? $"{_dossier?.NomEtablissement} a été validée. Sa fiche est maintenant publique et le partenaire verra immédiatement son statut vérifié."
                : status == "missing_documents"
                    ? "Documents manquants : vérifiez la devanture et toutes les faces requises de la pièce d’identité."
                    : status == "not_found" ? "Ce dossier n’existe plus." : "La validation n’a pas pu être enregistrée. Réessayez.";
            if (success) { _decisionAt = DateTimeOffset.Now; await LoadAsync(); }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RejeterAsync()
    {
        if (_busy) return;
        _busy = true; _message = null;
        try
        {
            var (success, status) = await AdminApi.RejeterDossierAsync(_apiKey!, Id, _motifRejet, CancellationToken.None);
            _success = success;
            _message = success ? "Le dossier a été rejeté. Le motif est visible dans l’espace partenaire afin qu’il puisse corriger et renvoyer ses documents." : status == "motif_requis" ? "Indiquez un motif précis pour aider le partenaire." : "Le rejet n’a pas pu être enregistré.";
            if (success) { _decisionAt = DateTimeOffset.Now; await LoadAsync(); }
        }
        finally
        {
            _busy = false;
        }
    }

    private static string StatusLabel(string status) => status switch { "VALIDE" => "Vérifiée", "REJETE" => "À corriger", _ => "En attente d’examen" };
    private static string StatusClass(string status) => status switch { "VALIDE" => "is-approved", "REJETE" => "is-rejected", _ => "is-pending" };
}
