@page "/partenaire/etablissements/{Id:guid}/scanner"
@using KekeBeauty.Web.Components.Layout
@inject PartnerRdvApiClient Api
@inject PartnerSessionService Session
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IAsyncDisposable
@rendermode @(new InteractiveServerRenderMode(prerender:false))
<PageTitle>Scanner un pass — Keke Beauty</PageTitle>
<PartnerDesktopHeader ActivePath="rdv" IdEtablissement="Id" />
<main class="premium-page"><div class="premium-container max-w-2xl"><a class="premium-back" href="@($"/partenaire/etablissements/{Id}/rdv")"><span class="material-symbols-outlined">arrow_back</span>Retour à l’agenda</a><section class="partner-hero mt-space-sm mb-6"><div class="partner-hero-glow" aria-hidden="true"></div><div class="relative z-10"><p class="font-label-sm text-label-sm uppercase tracking-[0.18em] partner-hero-eyebrow mb-1">Contrôle d’arrivée</p><h1 class="font-headline-lg text-headline-lg text-white font-bold partner-hero-title">Scanner un pass de réservation</h1><p class="font-body-sm text-body-sm partner-hero-sub mt-1">Le QR est vérifié cryptographiquement et doit appartenir à votre établissement.</p></div></section><section class="premium-card qr-scanner-card"><div class="scanner-viewport"><video id="qr-video" playsinline muted></video><div class="scanner-guide"><i></i><i></i><i></i><i></i></div></div><button class="premium-primary-action" @onclick="StartScanner"><span class="material-symbols-outlined">qr_code_scanner</span>Activer la caméra</button>@if(_cameraStatus is not null){<KekeAlert Severity="warning" Title="Caméra">@_cameraStatus</KekeAlert>}<div class="manual-token"><span>ou</span><label><strong>Coller le lien ou le jeton du QR</strong><textarea class="onboarding-input" rows="3" @bind="_manual"></textarea></label><button class="flow-secondary" disabled="@string.IsNullOrWhiteSpace(_manual)" @onclick='()=>Verify(_manual!)'>Vérifier</button></div></section>@if(_result is not null){<section class="qr-result valid"><span class="material-symbols-outlined">verified</span><div><small>PASS AUTHENTIQUE</small><h2>@_result.Reference</h2><p>@_result.LibellePrestation</p><strong>@_result.DateHeureDebut.ToLocalTime().ToString("dddd d MMMM yyyy à HH:mm",Fr)</strong><em>@StatusLabel(_result.Statut)</em></div></section>}<ToastBridge Message="@_error" Severity="danger" OnShown="@(() => _error = null)" /></div></main>
@code{[Parameter]public Guid Id{get;set;}Guid? _partner;string? _manual,_cameraStatus,_error;QrVerificationDto? _result;DotNetObjectReference<PartnerQrScanner>? _ref;static readonly System.Globalization.CultureInfo Fr=System.Globalization.CultureInfo.GetCultureInfo("fr-FR");protected override async Task OnInitializedAsync(){_partner=await Session.GetPartnerIdAsync();if(_partner is null)Navigation.NavigateTo("/login?role=partenaire");}async Task StartScanner(){_ref??=DotNetObjectReference.Create(this);var result=await JS.InvokeAsync<CameraResult>("kekeQr.start","qr-video",_ref);_cameraStatus=result.Ok?null:result.Status=="unsupported"?"Le scan caméra n’est pas supporté sur ce navigateur. Collez le lien du QR ci-dessous.":"Autorisez la caméra pour scanner le pass.";}[JSInvokable]public async Task ReceiveQr(string raw)=>await Verify(raw);async Task Verify(string raw){_error=null;_result=null;var token=ExtractToken(raw);var(ok,result,status)=await Api.VerifyQrAsync(_partner!.Value,token,CancellationToken.None);if(ok)_result=result;else _error=status=="Forbidden"?"Ce pass appartient à un autre établissement.":status=="BadRequest"?"Le QR est invalide, altéré ou expiré.":"Impossible de vérifier ce pass.";}static string ExtractToken(string raw){if(Uri.TryCreate(raw,UriKind.Absolute,out var uri)){var pair=uri.Query.TrimStart('?').Split('&').FirstOrDefault(x=>x.StartsWith("token="));if(pair is not null)return Uri.UnescapeDataString(pair[6..]);}return raw.Trim();}static string StatusLabel(string s)=>s switch{"CONFIRME"=>"Rendez-vous confirmé","TERMINE"=>"Soin terminé","ANNULE"=>"Rendez-vous annulé","REFUSE"=>"Demande refusée",_=>"En attente"};public async ValueTask DisposeAsync(){try{await JS.InvokeVoidAsync("kekeQr.stop");}catch{}_ref?.Dispose();}sealed class CameraResult{public bool Ok{get;set;}public string Status{get;set;}="";}}