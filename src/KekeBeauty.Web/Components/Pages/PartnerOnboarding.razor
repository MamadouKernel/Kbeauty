@page "/partenaire/inscription"
@inject PartnerApiClient PartnerApi
@inject AuthApiClient AuthApi
@inject PartnerSessionService PartnerSession
@inject IConfiguration Configuration
@inject IJSRuntime JS
@inject KekeBeauty.Web.Services.GeoApiClient Geo
@implements IAsyncDisposable
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Créer ma boutique — Keke Beauty</PageTitle>
<header class="fixed top-0 inset-x-0 z-50 bg-surface-cream/95 backdrop-blur-xl shadow-sm pt-safe">
 <div class="h-16 px-margin flex items-center justify-between max-w-4xl mx-auto"><a class="w-10 h-10 rounded-full flex items-center justify-center text-primary" href="@(_connectedAccount ? "/partenaire" : "/")"><span class="material-symbols-outlined">arrow_back</span></a><div class="flex items-center gap-2"><img alt="Keke Beauty" class="h-10 w-auto" src="/img/logo.png"/><strong class="text-primary">Créer ma boutique</strong></div><span class="text-label-sm text-primary font-bold">@_step/5</span></div>
 <div class="h-1 bg-surface-container"><div class="h-full bg-gradient-to-r from-primary to-secondary transition-all" style="width:@(_step * 20)%"></div></div>
</header>
<main id="main-content" class="min-h-screen bg-surface pt-24 pb-28"><div class="max-w-2xl mx-auto px-margin">
@if (_success) {
 <section class="bg-surface-cream rounded-3xl p-8 text-center shadow-lg mt-8"><div class="w-20 h-20 mx-auto rounded-full bg-status-available/10 text-status-available flex items-center justify-center"><span class="material-symbols-outlined text-[42px]">check_circle</span></div><h1 class="text-headline-lg font-headline-lg text-primary mt-5">Votre boutique est créée !</h1><p class="text-on-surface-variant mt-2">Votre dossier est en cours de vérification. Nous vous informerons dès sa validation.</p><a class="mt-6 block py-3 rounded-full bg-primary text-white font-bold" href="@(_connectedAccount ? "/partenaire" : "/login?role=partenaire")">Accéder à mon espace</a></section>
} else {
 <div class="mb-5"><span class="text-label-sm font-label-sm uppercase tracking-widest text-secondary">@Eyebrow</span><h1 class="text-headline-lg font-headline-lg text-text-primary mt-1">@Title</h1><p class="text-body-md text-on-surface-variant mt-2">@Description</p></div>
 @if (_connectedAccount) { <KekeAlert Severity="success" Title="Compte partenaire connecté">Votre identité a été vérifiée. La boutique sera automatiquement rattachée à votre compte actuel.</KekeAlert> }
 <section class="bg-surface-cream rounded-3xl p-space-md sm:p-6 shadow-[0_12px_40px_-20px_rgba(58,13,82,.35)]">
 @if (_step == 1) {
  <div class="space-y-4">
   @if (!string.IsNullOrWhiteSpace(_googleClientId)) { <div id="partner-google-signin" class="google-signin-button min-h-11"></div><div class="flex items-center gap-3 text-on-surface-variant"><span class="h-px bg-outline-variant flex-1"></span><span>ou</span><span class="h-px bg-outline-variant flex-1"></span></div> }
   <button type="button" class="w-full py-3 rounded-full border-2 border-primary text-primary font-bold flex items-center justify-center gap-2" @onclick="UsePhone"><span class="material-symbols-outlined">chat</span>Continuer avec WhatsApp</button>
   @if (!_emailAuthMode) { <button type="button" class="w-full py-3 rounded-full border-2 border-primary text-primary font-bold flex items-center justify-center gap-2" @onclick="UseEmailPassword"><span class="material-symbols-outlined">mail</span>Créer avec un email et un mot de passe</button> }
   @if (_googleConnected) { <KekeAlert Severity="success" Title="Compte Google vérifié">Ajoutez votre téléphone professionnel.</KekeAlert> }
   @if (_authChoiceMade && !_emailAuthMode) {
    <label class="block"><span class="font-label-md">Téléphone professionnel</span><input class="onboarding-input" type="tel" placeholder="+225 07 00 00 00 00" @bind="_telephone" @bind:event="oninput" disabled="@_phoneVerified"/></label>
    @if (!_googleConnected && !_otpSent) { <button type="button" class="w-full py-3 rounded-full bg-primary text-white font-bold disabled:opacity-50" disabled="@(_busy || string.IsNullOrWhiteSpace(_telephone))" @onclick="RequestOnboardingOtpAsync">Recevoir mon code WhatsApp</button> }
    @if (!_googleConnected && _otpSent && !_phoneVerified) { <label class="block"><span class="font-label-md">Code reçu</span><input class="onboarding-input" inputmode="numeric" maxlength="6" placeholder="000000" @bind="_otpCode" @bind:event="oninput"/></label><button type="button" class="w-full py-3 rounded-full bg-primary text-white font-bold disabled:opacity-50" disabled="@(_busy || _otpCode.Length != 6)" @onclick="VerifyOnboardingOtpAsync">Vérifier le code</button> }
    @if (_phoneVerified) { <KekeAlert Severity="success" Title="Téléphone vérifié">Votre identité WhatsApp est confirmée.</KekeAlert> }
   }
    @if (_emailAuthMode && _emailAuthStep == "form" && !_phoneVerified) {
     <div class="auth-mode-switch"><button type="button" class="@(!_emailLoginMode?"active":"")" @onclick="ShowEmailRegistration">Nouveau compte</button><button type="button" class="@(_emailLoginMode?"active":"")" @onclick="ShowEmailLogin">J’ai déjà un compte</button></div>
     @if(!_emailLoginMode){<label class="block"><span class="font-label-md">Nom complet</span><input class="onboarding-input" placeholder="Votre nom et prénoms" @bind="_emailNom" @bind:event="oninput"/></label>}
     <label class="block"><span class="font-label-md">Téléphone professionnel</span><input class="onboarding-input" type="tel" placeholder="+225 07 00 00 00 00" @bind="_telephone" @bind:event="oninput"/></label>
     <label class="block"><span class="font-label-md">Email</span><input class="onboarding-input" type="email" @bind="_emailAddr" @bind:event="oninput"/></label>
     <label class="block"><span class="font-label-md">Mot de passe (8 caractères minimum)</span><input class="onboarding-input" type="password" @bind="_emailPassword" @bind:event="oninput"/></label>
     @if(_emailLoginMode){<button type="button" class="w-full py-3 rounded-full bg-primary text-white font-bold disabled:opacity-50" disabled="@(_busy || string.IsNullOrWhiteSpace(_telephone) || string.IsNullOrWhiteSpace(_emailAddr) || _emailPassword.Length < 8)" @onclick="LoginExistingEmailPasswordAsync">Se connecter</button><a class="block text-center text-primary underline" href="/mot-de-passe-oublie">Mot de passe oublié ?</a>}else{<button type="button" class="w-full py-3 rounded-full bg-primary text-white font-bold disabled:opacity-50" disabled="@(_busy || string.IsNullOrWhiteSpace(_emailNom) || string.IsNullOrWhiteSpace(_telephone) || string.IsNullOrWhiteSpace(_emailAddr) || _emailPassword.Length < 8)" @onclick="RegisterEmailPasswordAsync">Créer mon compte</button>}
   }
   @if (_emailAuthMode && _emailAuthStep == "verify") {
    <KekeAlert Severity="info" Title="Vérifiez votre email">Entrez le code à 6 chiffres envoyé par email.</KekeAlert>
    <label class="block"><span class="font-label-md">Code reçu</span><input class="onboarding-input" inputmode="numeric" maxlength="6" placeholder="000000" @bind="_emailCode" @bind:event="oninput"/></label>
    <button type="button" class="w-full py-3 rounded-full bg-primary text-white font-bold disabled:opacity-50" disabled="@(_busy || _emailCode.Length != 6)" @onclick="VerifyAndLoginEmailPasswordAsync">Vérifier le code</button>
   }
    @if (_phoneVerified && _emailAuthMode) { <KekeAlert Severity="success" Title="Compte vérifié">Votre identité est confirmée. Vous pouvez maintenant continuer.</KekeAlert> }
  </div>
 } else if (_step == 2) {
  <div class="space-y-4"><label class="block"><span class="font-label-md">Nom de la boutique</span><input class="onboarding-input" placeholder="Ex. Divine Beauty Cocody" @bind="_nom" @bind:event="oninput"/></label><label class="block"><span class="font-label-md">Activité principale</span><select class="onboarding-input" @bind="_categorie"><option value="">Choisir une activité</option><option>Coiffure &amp; Tresses</option><option>Onglerie &amp; Art</option><option>Espace Spa</option><option>Massages</option><option>Soins Visage</option><option>Autre</option></select></label><label class="block"><span class="font-label-md">Numéro visible par les clientes</span><input class="onboarding-input" type="tel" placeholder="Même numéro ou numéro du magasin" @bind="_contact" @bind:event="oninput"/></label></div>
 } else if (_step == 3) {
  <div class="space-y-4">
   <button type="button" class="w-full py-3 rounded-full bg-primary text-white font-bold flex items-center justify-center gap-2 disabled:opacity-60" disabled="@_locating" @onclick="LocateAsync"><span class="material-symbols-outlined">my_location</span>@(_locating ? "Localisation en cours…" : "Utiliser ma position actuelle")</button>
   @if (_locationMessage is not null) { <KekeAlert Severity="@(_locationOk ? "success" : "warning")" Title="@(_locationOk ? "Localisation confirmée" : "Localisation requise")">@_locationMessage</KekeAlert> }
   <div class="relative">
    <label class="block"><span class="font-label-md">Ou recherchez votre adresse</span><input class="onboarding-input" placeholder="Ex. Rue des Jardins, Cocody" @bind="_addressQuery" @bind:event="oninput" @onkeyup="OnAddressKeyUp"/></label>
    @if (_addressSuggestions.Count > 0) {
     <ul class="address-suggestions">@foreach (var s in _addressSuggestions) { <li><button type="button" @onclick="() => SelectAddressAsync(s)">@s.DisplayName</button></li> }</ul>
    }
   </div>
   <div id="onboarding-picker-map" class="onboarding-picker-map"></div>
   <p class="text-label-sm text-on-surface-variant">Glissez le repère ou touchez la carte pour affiner l’emplacement exact.</p>
   @if (!string.IsNullOrWhiteSpace(_adresseTexte)) { <KekeAlert Severity="info" Title="Adresse détectée">@_adresseTexte</KekeAlert> }
   <div class="grid grid-cols-2 gap-3"><label><span class="font-label-md">Latitude</span><input class="onboarding-input" type="number" step="0.000001" @bind="_lat"/></label><label><span class="font-label-md">Longitude</span><input class="onboarding-input" type="number" step="0.000001" @bind="_lng"/></label></div>
   <label class="block"><span class="font-label-md">Horaires</span><select class="onboarding-input" @bind="_horaires"><option value="">Choisir</option><option value="Lun-Sam 08h00-19h00">Lun–Sam, 8h–19h</option><option value="Lun-Sam 09h00-18h00">Lun–Sam, 9h–18h</option><option value="Tous les jours 08h00-20h00">Tous les jours, 8h–20h</option><option value="Sur rendez-vous uniquement">Sur rendez-vous uniquement</option></select></label>
  </div>
 } else if (_step == 4) {
  <div class="space-y-6 kyc-capture-flow">
   <KekeAlert Severity="info" Title="Photos nettes et originales">Utilisez une lumière naturelle, évitez les reflets et placez le document entier dans le cadre. Vos pièces sont protégées et réservées à la vérification.</KekeAlert>
   <section class="capture-shell"><div class="capture-copy"><span class="capture-step">1</span><div><strong>Devanture de la boutique</strong><small>Choisissez dans votre galerie une photo nette avec l’enseigne lisible.</small></div></div><div class="capture-frame is-storefront">@if(_photoBytes is not null){<span class="material-symbols-outlined capture-icon">check_circle</span><span class="selected-file-label">Devanture ajoutée</span>}else{<span class="material-symbols-outlined capture-icon">storefront</span><span>Photo de la façade</span>}<i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i></div><label class="premium-upload-button"><span class="material-symbols-outlined">photo_library</span>@(_photoBytes is null?"Choisir depuis la galerie":"Remplacer la devanture")<InputFile @key="_photoInputKey" id="kyc-storefront-file" OnChange="OnPhoto" accept="image/jpeg,image/png,image/webp"/></label>@if(_photoName is not null){<span class="upload-ok">✓ @_photoName</span>}</section>
   <div><span class="font-label-md">Type de pièce d’identité</span><div class="grid grid-cols-2 gap-3 mt-2"><button type="button" class="document-choice @(_documentType == "CNI" ? "selected" : "")" @onclick='() => SelectDocumentType("CNI")'><span class="material-symbols-outlined">badge</span>Carte d’identité</button><button type="button" class="document-choice @(_documentType == "PASSEPORT" ? "selected" : "")" @onclick='() => SelectDocumentType("PASSEPORT")'><span class="material-symbols-outlined">menu_book</span>Passeport</button></div></div>
   <section class="capture-shell"><div class="capture-copy"><span class="capture-step">2</span><div><strong>@(_documentType=="PASSEPORT"?"Page d’identification":"Recto de la carte")</strong><small>@(_documentType=="PASSEPORT"?"Choisissez la page contenant votre photo.":"Choisissez la face contenant votre photo, nom et numéro.")</small></div></div><div class="capture-frame @(_documentType=="PASSEPORT"?"is-passport":"is-card")">@if(_rectoBytes is not null){<span class="material-symbols-outlined capture-icon">check_circle</span><span class="selected-file-label">@(_documentType=="PASSEPORT"?"Passeport ajouté":"Recto ajouté")</span>}else{<span class="document-guide">@(_documentType=="PASSEPORT"?"PAGE D’IDENTIFICATION":"RECTO")</span>}<i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i></div><label class="premium-upload-button"><span class="material-symbols-outlined">upload_file</span>@(_rectoBytes is null?"Choisir dans la galerie ou les fichiers":"Remplacer ce document")<InputFile @key="_rectoInputKey" id="kyc-identity-front-file" OnChange="OnDocumentRecto" accept="image/jpeg,image/png,image/webp,application/pdf"/></label>@if(_rectoName is not null){<span class="upload-ok">✓ @_rectoName</span>}</section>
   @if(_documentType=="CNI"){
    <section class="capture-shell"><div class="capture-copy"><span class="capture-step">3</span><div><strong>Verso de la carte</strong><small>Choisissez le verso avec les quatre bords visibles.</small></div></div><div class="capture-frame is-card">@if(_versoBytes is not null){<span class="material-symbols-outlined capture-icon">check_circle</span><span class="selected-file-label">Verso ajouté</span>}else{<span class="document-guide">VERSO</span>}<i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i></div><label class="premium-upload-button"><span class="material-symbols-outlined">upload_file</span>@(_versoBytes is null?"Choisir dans la galerie ou les fichiers":"Remplacer le verso")<InputFile @key="_versoInputKey" id="kyc-identity-back-file" OnChange="OnDocumentVerso" accept="image/jpeg,image/png,image/webp,application/pdf"/></label>@if(_versoName is not null){<span class="upload-ok">✓ @_versoName</span>}</section>
   }
   <KekeAlert Severity="success" Title="Pack Free inclus">Votre boutique démarre gratuitement. Vous pourrez activer les avantages Pro après validation.</KekeAlert>
  </div> } else {
  <div class="space-y-3"><div class="summary-row"><span class="material-symbols-outlined">storefront</span><div><small>Boutique</small><strong>@_nom</strong></div></div><div class="summary-row"><span class="material-symbols-outlined">category</span><div><small>Activité</small><strong>@_categorie</strong></div></div><div class="summary-row"><span class="material-symbols-outlined">call</span><div><small>Contact</small><strong>@_contact</strong></div></div><div class="summary-row"><span class="material-symbols-outlined">schedule</span><div><small>Horaires</small><strong>@(string.IsNullOrWhiteSpace(_horaires) ? "À définir plus tard" : _horaires)</strong></div></div><div class="summary-row"><span class="material-symbols-outlined">location_on</span><div><small>Position</small><strong>@($"{_lat:N5}, {_lng:N5}")</strong></div></div><KekeAlert Severity="warning" Title="Vérification obligatoire">Après la création, la boutique restera en attente jusqu’à la validation des documents KYC.</KekeAlert><label class="flex items-start gap-3 mt-4"><input class="mt-1" type="checkbox" @bind="_accepted"/><span class="text-body-sm text-on-surface-variant">Je confirme l’exactitude des informations et accepte les conditions d’utilisation.</span></label></div>
 }
 <ToastBridge Message="@_message" Severity="@_messageSeverity" OnShown="@(() => _message = null)" />
 </section>
  @if(_step!=1||CanContinueIdentity){<div class="flex gap-3 mt-5">@if (_step > 1) { <button type="button" class="flex-1 py-3 rounded-full bg-surface-container text-primary font-bold" disabled="@_busy" @onclick="Previous">Retour</button> }<button type="button" class="flex-[2] py-3 rounded-full bg-primary text-white font-bold shadow-md disabled:opacity-50" disabled="@_busy" @onclick="NextAsync">@(_step == 5 ? (_busy ? "Création en cours…" : "Créer ma boutique") : "Continuer")</button></div>}@if(_step==5&&!string.IsNullOrWhiteSpace(_submitStatus)){<div class="submit-progress @(_messageSeverity=="danger"?"is-error":"")" role="status"><span class="material-symbols-outlined">@(_busy?"progress_activity":_messageSeverity=="danger"?"error":"cloud_done")</span><span>@_submitStatus</span></div>}<p class="text-center text-label-sm text-on-surface-variant mt-4">Brouillon enregistré automatiquement sur cet appareil.</p>
}
</div></main>

@code {
int _step=1; bool _busy,_success,_authChoiceMade,_googleConnected,_phoneVerified,_otpSent,_accepted,_locating,_locationOk,_connectedAccount; string _telephone="",_nom="",_contact="",_categorie=""; string? _horaires,_message,_locationMessage,_googleClientId,_googleToken,_partnerSessionToken,_photoName,_rectoName,_versoName; string _documentType="CNI",_messageSeverity="danger",_otpCode=""; decimal _lat,_lng; byte[]? _photoBytes,_rectoBytes,_versoBytes; int _photoInputKey,_rectoInputKey,_versoInputKey; DotNetObjectReference<PartnerOnboarding>? _googleRef; const long MaxFileSize=8*1024*1024;
 bool _emailAuthMode,_emailLoginMode; string _emailAuthStep="form"; string _emailNom="",_emailAddr="",_emailPassword="",_emailCode=""; Guid? _emailIdUtilisateur;
