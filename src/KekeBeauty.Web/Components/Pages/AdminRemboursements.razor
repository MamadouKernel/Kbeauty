@page "/admin/remboursements"
@inject AdminApiClient AdminApi
@inject AdminSessionService Session
@inject NavigationManager Navigation
@* prerender:false : voir AdminDashboard.razor pour le detail du bug de prerendering evite. *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Remboursements — Super-Admin</PageTitle>

@using KekeBeauty.Web.Components.Layout
<AdminHeader ActivePath="/admin/remboursements" />

<main id="main-content" tabindex="-1" class="admin-page flex flex-col relative w-full pt-16 pb-space-xl bg-surface min-h-screen">
    <div class="flex flex-col w-full px-margin py-space-lg gap-space-lg lg:max-w-4xl lg:mx-auto">
        @if (_checkingAuth)
        {
            <p class="font-body-md text-body-md text-on-surface-variant">Chargement…</p>
        }
        else
        {
            <div>
                <h1 class="font-headline-lg text-headline-lg text-text-primary">Demandes de remboursement</h1>
                <p class="font-body-md text-body-md text-on-surface-variant">
                    Les paiements Wave directs peuvent être remboursés automatiquement. Pour un ancien paiement WiniPayer ou un autre canal, effectuez le remboursement manuellement puis tracez sa référence.
                </p>
            </div>

            @if (_demandes.Count == 0)
            {
                <p class="font-body-sm text-body-sm text-on-surface-variant py-space-sm">Aucune demande de remboursement en attente.</p>
            }
            else
            {
                <div class="flex flex-col gap-space-sm">
                    @foreach (var demande in _demandes)
                    {
                        <div class="bg-surface-cream rounded-xl p-space-md shadow-sm space-y-space-sm">
                            <div class="flex items-center justify-between">
                                <p class="font-label-md text-label-md text-text-primary">@demande.NomEtablissement</p>
                                <p class="font-headline-sm text-headline-sm text-primary font-bold">@demande.Montant.ToString("N0") FCFA</p>
                            </div>
                            <p class="font-body-sm text-body-sm text-on-surface-variant">Client @demande.TelephoneClient · Demandé le @demande.DateTransaction.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>

                            @if (_idRdvEnCours == demande.IdRdv)
                            {
                                <div class="flex flex-col gap-space-xs">
                                    <input class="w-full bg-surface-container-low rounded-lg px-3 py-2.5 text-body-sm focus:outline-none" placeholder="Référence du virement / mobile money effectué" @bind="_reference" @bind:event="oninput" />
                                    <div class="flex gap-2">
                                        <button class="flex-1 py-2 rounded-full bg-primary-container text-on-primary font-label-sm text-label-sm shadow-sm disabled:opacity-60" type="button" @onclick="() => TraiterAsync(demande.IdRdv)" disabled="@string.IsNullOrWhiteSpace(_reference)">Marquer remboursé</button>
                                        <button class="px-3 py-2 rounded-full bg-surface-container text-text-primary font-label-sm text-label-sm" type="button" @onclick="() => _idRdvEnCours = null">Annuler</button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="flex flex-wrap gap-3">
                                    <button class="px-4 py-2 rounded-full bg-primary text-on-primary font-label-sm" type="button" @onclick="() => ExecuterWaveAsync(demande.IdRdv)" disabled="@(_waveEnCours == demande.IdRdv)">@(_waveEnCours == demande.IdRdv ? "Traitement…" : "Rembourser via Wave")</button>
                                    <button class="font-label-sm text-label-sm text-primary underline" type="button" @onclick="() => StartTraiter(demande.IdRdv)">Saisir un remboursement manuel</button>
                                </div>
                            }
                        </div>
                    }
                </div>
            }

            @if (!string.IsNullOrEmpty(_message))
            {
                <div class="rounded-xl px-space-md py-space-sm font-body-md text-body-md bg-status-available/10 text-status-available">@_message</div>
            }
        }
    </div>
</main>

@code {
    private string? _apiKey;
    private bool _checkingAuth = true;
    private List<DemandeRemboursementItem> _demandes = [];
    private Guid? _idRdvEnCours;
    private string? _reference;
    private string? _message;
    private Guid? _waveEnCours;

    protected override async Task OnInitializedAsync()
    {
        _apiKey = await Session.GetApiKeyAsync();
        if (_apiKey is null)
        {
            Navigation.NavigateTo("/admin/login");
            return;
        }

        await LoadAsync();
        _checkingAuth = false;
    }

    private async Task LoadAsync()
    {
        var (success, demandes) = await AdminApi.ListerRemboursementsAsync(_apiKey!, CancellationToken.None);
        if (success)
        {
            _demandes = demandes;
        }
    }

    private void StartTraiter(Guid idRdv)
    {
        _idRdvEnCours = idRdv;
        _reference = null;
    }

    private async Task ExecuterWaveAsync(Guid idRdv)
    {
        _waveEnCours = idRdv;
        var (success, status) = await AdminApi.ExecuterRemboursementWaveAsync(_apiKey!, idRdv, CancellationToken.None);
        _message = success ? "Remboursement Wave exécuté et tracé."
            : status == "wave_not_configured" ? "Wave Business n’est pas encore configuré côté serveur."
            : status == "unsupported_payment_provider" ? "Ce paiement vient de WiniPayer : utilisez le traitement manuel."
            : "Le remboursement Wave a échoué. Consultez le journal administrateur.";
        _waveEnCours = null;
        if (success) await LoadAsync();
    }
    private async Task TraiterAsync(Guid idRdv)
    {
        if (string.IsNullOrWhiteSpace(_reference))
        {
            return;
        }

        var (success, _) = await AdminApi.TraiterRemboursementAsync(_apiKey!, idRdv, _reference, CancellationToken.None);
        _message = success ? "Remboursement marqué comme effectué." : "Échec de l'enregistrement.";
        if (success)
        {
            _idRdvEnCours = null;
            await LoadAsync();
        }
    }
}
