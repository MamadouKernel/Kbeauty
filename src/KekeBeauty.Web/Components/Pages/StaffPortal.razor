@page "/staff"
@inject StaffApiClient StaffApi
@inject StaffSessionService Session
@inject NavigationManager Navigation
@implements IAsyncDisposable
@rendermode @(new InteractiveServerRenderMode(prerender:false))
<PageTitle>Poste collaboratrice — Keke Beauty</PageTitle>
<header class="staff-premium-header"><a href="/staff"><img src="/img/logo.png" alt="Keke Beauty"/><strong>Poste collaboratrice</strong></a><button class="session-logout" @onclick="LogoutAsync"><span class="material-symbols-outlined">logout</span>Déconnexion</button></header>
<main id="main-content" class="premium-page staff-page"><div class="premium-container max-w-5xl">
 <section class="staff-welcome"><div><p class="flow-eyebrow">TABLETTE MIROIR</p><h1>Votre journée, en un regard.</h1><p>Préparez chaque cliente, chronométrez le soin et consignez votre diagnostic.</p></div><span class="material-symbols-outlined">content_cut</span></section>
 @if(_checking){<div class="premium-loading">Chargement de votre poste…</div>}else{
 <nav class="segmented-tabs"><button class="@Tab("planning")" @onclick='()=>SetTab("planning")'>Planning</button><button class="@Tab("live")" @onclick='()=>SetTab("live")'>Poste en direct</button><button class="@Tab("commissions")" @onclick='()=>SetTab("commissions")'>Commissions</button></nav>
 @if(_tab=="planning"){
  <section class="staff-planning">@foreach(var item in _planning.OrderBy(x=>x.DateHeureDebut)){<button class="staff-appointment @StatusClass(item)" @onclick="()=>OpenLive(item)"><time>@item.DateHeureDebut.ToLocalTime().ToString("HH:mm")</time><div><strong>@item.NomClient</strong><span>@item.LibellePrestation · @item.DureeMinutes min</span><small>@item.NomEtablissement @if(item.RetardMinutes is not null){<b>· Retard +@item.RetardMinutes min</b>}</small></div><em>@StatusLabel(item)</em></button>}@if(_planning.Count==0){<div class="premium-empty"><span class="material-symbols-outlined">event_available</span><h2>Planning libre</h2><p>Aucun rendez-vous ne vous est assigné.</p></div>}</section>
 }else if(_tab=="live"){
  @if(_active is null){<div class="premium-empty"><span class="material-symbols-outlined">touch_app</span><h2>Sélectionnez une cliente</h2><p>Ouvrez un rendez-vous depuis le planning pour démarrer le poste de travail.</p><button class="premium-primary-compact" @onclick='()=>_tab="planning"'>Voir le planning</button></div>}
  else{<section class="workstation"><div class="workstation-hero"><div><span class="premium-eyebrow">Soin en cours</span><h2>@_active.NomClient</h2><p>@_active.LibellePrestation · durée prévue @_active.DureeMinutes min</p></div><div class="live-status @(_active.DatePause is null?"":"paused")"><i></i>@LiveLabel</div></div>@if(_active.RetardMinutes is not null){<KekeAlert Severity="warning" Title="Cliente en retard">Retard annoncé : environ @_active.RetardMinutes minutes. Le poste reste réservé.</KekeAlert>}<div class="work-timer">@Elapsed</div><div class="timer-progress"><i style="width:@Progress%"></i></div><div class="timer-actions">@if(_active.DateDebutReelle is null){<button class="start" @onclick='()=>WorkAction("start")'><span class="material-symbols-outlined">play_arrow</span>Démarrer</button>}else if(_active.DateFinReelle is null){@if(_active.DatePause is null){<button @onclick='()=>WorkAction("pause")'><span class="material-symbols-outlined">pause</span>Pause</button>}else{<button class="start" @onclick='()=>WorkAction("resume")'><span class="material-symbols-outlined">play_arrow</span>Reprendre</button>}<button class="finish" @onclick='()=>WorkAction("finish")'><span class="material-symbols-outlined">check_circle</span>Terminer</button>}</div>
   <div class="diagnostic-grid"><label><span>Type de cheveux</span><select class="onboarding-input" @bind="_hairType"><option value="">Sélectionner</option><option>4C</option><option>4B</option><option>4A</option><option>Défrisé</option><option>Locks</option><option>Autre</option></select></label><label><span>Boisson préférée</span><input class="onboarding-input" placeholder="Eau, bissap, café…" @bind="_drink"/></label><label class="wide"><span>Sensibilités / alertes</span><input class="onboarding-input" placeholder="Cuir chevelu sensible, allergie…" @bind="_sensitivity"/></label><label class="wide"><span>Diagnostic et produits utilisés</span><textarea class="onboarding-input" rows="4" @bind="_notes"></textarea></label></div><button class="premium-primary-action" @onclick="SaveDiagnostic"><span class="material-symbols-outlined">clinical_notes</span>Enregistrer la fiche technique</button></section>}
 }else{
  <section class="commission-summary"><div><span>Total reçu</span><strong>@_commissions.Where(x=>x.StatutPaiement=="success").Sum(x=>x.Montant).ToString("N0") FCFA</strong><small>100 % pour vous · 0 % de commission</small></div></section><div class="commission-list">@foreach(var item in _commissions){<article><span class="material-symbols-outlined">volunteer_activism</span><div><strong>@item.Montant.ToString("N0") FCFA</strong><small>@item.DateHeureDebut.ToLocalTime().ToString("dd MMM yyyy",Fr)</small></div><em>@item.StatutPaiement</em></article>}</div>
 }
 <ToastBridge Message="@_message" Severity="@(_success?"success":"danger")" OnShown="@(() => _message = null)" />
 }
</div></main>
@code{
 Guid? _user;bool _checking=true,_success;string _tab="planning";string? _message;List<PlanningItemDto> _planning=[];List<CommissionItemDto> _commissions=[];PlanningItemDto? _active;string _hairType="",_drink="",_sensitivity="",_notes="";CancellationTokenSource _clockCts=new();static readonly System.Globalization.CultureInfo Fr=System.Globalization.CultureInfo.GetCultureInfo("fr-FR");
 protected override async Task OnInitializedAsync(){_user=await Session.GetStaffIdAsync();if(_user is null){Navigation.NavigateTo("/login?role=collaboratrice");return;}await LoadPlanning();_checking=false;_=TickAsync(_clockCts.Token);}
 async Task LoadPlanning(){var(ok,items)=await StaffApi.GetPlanningAsync(_user!.Value,CancellationToken.None);if(ok)_planning=items;}
 async Task SetTab(string tab){_tab=tab;if(tab=="commissions"&&_commissions.Count==0){var(ok,items)=await StaffApi.GetCommissionsAsync(_user!.Value,CancellationToken.None);if(ok)_commissions=items;}}
 async Task OpenLive(PlanningItemDto item){_active=item;_tab="live";var(ok,notes)=await StaffApi.GetFicheTechniqueAsync(_user!.Value,item.IdRdv,CancellationToken.None);if(ok&&notes is not null)ParseNotes(notes);}
 async Task WorkAction(string action){if(_active is null)return;var(ok,status)=await StaffApi.UpdateWorkSessionAsync(_user!.Value,_active.IdRdv,action,CancellationToken.None);_success=ok;_message=ok?action switch{"start"=>"Chronomètre démarré.","pause"=>"Soin mis en pause.","resume"=>"Soin repris.",_=>"Prestation terminée."}:status=="transition_invalide"?"Cette action ne correspond pas à l’état actuel du soin.":"La commande n’a pas pu être enregistrée.";if(ok){await LoadPlanning();_active=_planning.FirstOrDefault(x=>x.IdRdv==_active.IdRdv);}}
 async Task SaveDiagnostic(){if(_active is null)return;var text=$"Type de cheveux: {_hairType}\nBoisson préférée: {_drink}\nSensibilités: {_sensitivity}\nDiagnostic / produits: {_notes}";var ok=await StaffApi.SaveFicheTechniqueAsync(_user!.Value,_active.IdRdv,text,CancellationToken.None);_success=ok;_message=ok?"Fiche technique enregistrée.":"Impossible d’enregistrer la fiche.";}
 void ParseNotes(string text){foreach(var line in text.Split('\n')){if(line.StartsWith("Type de cheveux:"))_hairType=line[16..].Trim();else if(line.StartsWith("Boisson préférée:"))_drink=line[17..].Trim();else if(line.StartsWith("Sensibilités:"))_sensitivity=line[13..].Trim();else if(line.StartsWith("Diagnostic / produits:"))_notes=line[22..].Trim();}if(string.IsNullOrWhiteSpace(_notes))_notes=text;}
 async Task TickAsync(CancellationToken ct){using var timer=new PeriodicTimer(TimeSpan.FromSeconds(1));try{while(await timer.WaitForNextTickAsync(ct))await InvokeAsync(StateHasChanged);}catch(OperationCanceledException){}}
 TimeSpan CurrentElapsed=>_active?.DateDebutReelle is null?TimeSpan.Zero:((_active.DateFinReelle??_active.DatePause??DateTimeOffset.Now)-_active.DateDebutReelle.Value-TimeSpan.FromSeconds(_active.DureePauseSecondes));string Elapsed=>$"{(int)CurrentElapsed.TotalHours:00}:{CurrentElapsed.Minutes:00}:{CurrentElapsed.Seconds:00}";double Progress=>_active is null||_active.DureeMinutes<=0?0:Math.Min(100,CurrentElapsed.TotalMinutes/_active.DureeMinutes*100);string LiveLabel=>_active?.DateFinReelle is not null?"Terminé":_active?.DateDebutReelle is null?"Prêt":_active?.DatePause is not null?"En pause":"En cours";
 string Tab(string x)=>_tab==x?"active":"";static string StatusLabel(PlanningItemDto x)=>x.StatutRdv switch{"EN_COURS"=>x.DatePause is null?"En cours":"Pause","CONFIRME"=>"Confirmé","TERMINE"=>"Terminé",_=>x.StatutRdv};static string StatusClass(PlanningItemDto x)=>x.StatutRdv.ToLowerInvariant();async Task LogoutAsync(){await Session.ClearAsync();Navigation.NavigateTo("/login?role=collaboratrice",true);}public ValueTask DisposeAsync(){_clockCts.Cancel();_clockCts.Dispose();return ValueTask.CompletedTask;}
}