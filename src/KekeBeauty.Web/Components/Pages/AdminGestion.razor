@page "/admin/gestion"
@inject AdminApiClient Api
@inject AdminSessionService Session
@inject NavigationManager Navigation
@rendermode @(new InteractiveServerRenderMode(prerender:false))
<PageTitle>Utilisateurs et boutiques</PageTitle>
@using KekeBeauty.Web.Components.Layout
@using KekeBeauty.Web.Models
<AdminHeader ActivePath="/admin/gestion" />
<main class="admin-page admin-legacy"><div class="admin-content"><h1>Utilisateurs et boutiques</h1>
<div class="input-group mb-4"><input class="form-control" placeholder="Nom, téléphone ou e-mail" @bind="_q" @bind:event="oninput"/><button class="btn btn-primary" @onclick="Load">Rechercher</button></div>
<h2>Comptes</h2><div class="table-responsive"><table class="table"><thead><tr><th>Nom</th><th>Contact</th><th>Type</th><th>État</th><th>Action</th></tr></thead><tbody>@foreach(var x in _users){<tr><td>@x.Nom</td><td>@x.Telephone<br/><small>@x.Email</small></td><td>@x.TypeCompte</td><td>@(x.EstSuspendu?"Suspendu":"Actif")</td><td><button class="btn btn-sm @(x.EstSuspendu?"btn-success":"btn-outline-danger")" @onclick="()=>ToggleUser(x)">@(x.EstSuspendu?"Réactiver":"Suspendre")</button></td></tr>}</tbody></table></div>
<h2>Boutiques</h2><div class="table-responsive"><table class="table"><thead><tr><th>Boutique</th><th>Gérant</th><th>KYC</th><th>État</th><th>Action</th></tr></thead><tbody>@foreach(var x in _shops){<tr><td>@x.NomEtablissement<br/><small>@x.Telephone</small></td><td>@x.Gerant</td><td>@x.StatutKyc</td><td>@(x.EstSuspendu?"Suspendue":"Active")</td><td><button class="btn btn-sm @(x.EstSuspendu?"btn-success":"btn-outline-danger")" @onclick="()=>ToggleShop(x)">@(x.EstSuspendu?"Réactiver":"Suspendre")</button></td></tr>}</tbody></table></div>
<ToastBridge Message="@_message" Severity="@(_success ? "success" : "danger")" OnShown="@(() => _message = null)" />
</div></main>
@code{string? _token;string _q="";string? _message;bool _success;List<AdminUserItemDto> _users=[];List<AdminShopItemDto> _shops=[];
protected override async Task OnInitializedAsync(){_token=await Session.GetApiKeyAsync();if(_token is null){Navigation.NavigateTo("/admin/login");return;}await Load();}
async Task Load(){if(_token is null)return;var u=await Api.SearchUsersAsync(_token,_q,CancellationToken.None);var s=await Api.SearchShopsAsync(_token,_q,CancellationToken.None);_users=u.Items;_shops=s.Items;if(!u.Success||!s.Success){_success=false;_message="Impossible de charger les données.";}}
async Task ToggleUser(AdminUserItemDto x){var r=x.EstSuspendu?await Api.ReactiverUtilisateurAsync(_token!,x.IdUtilisateur,CancellationToken.None):await Api.SuspendreUtilisateurAsync(_token!,x.IdUtilisateur,CancellationToken.None);_success=r.Success;_message=r.Success?"Compte mis à jour.":"Action impossible.";await Load();}
async Task ToggleShop(AdminShopItemDto x){var r=x.EstSuspendu?await Api.ReactiverEtablissementAsync(_token!,x.IdEtablissement,CancellationToken.None):await Api.SuspendreEtablissementAsync(_token!,x.IdEtablissement,CancellationToken.None);_success=r.Success;_message=r.Success?"Boutique mise à jour.":"Action impossible.";await Load();}}
