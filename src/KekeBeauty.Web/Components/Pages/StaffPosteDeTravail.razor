@page "/staff/poste-travail/{IdRdv:guid}"
@inject StaffApiClient StaffApi
@inject StaffSessionService Session
@inject NavigationManager Navigation
@implements IDisposable
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Poste de Travail Tactile & Chrono — Keke Staff</PageTitle>

<div class="min-h-screen bg-surface flex flex-col font-body-md text-body-md text-on-surface">
    <!-- Header Miroir -->
    <header class="fixed top-0 inset-x-0 h-16 bg-surface-cream/90 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)] z-40 flex items-center justify-between px-6 lg:px-10">
        <div class="flex items-center gap-4">
            <a class="w-10 h-10 rounded-full flex items-center justify-center hover:bg-lavender-subtle text-text-primary transition-colors" href="/staff" title="Retour au portail">
                <span class="material-symbols-outlined text-[22px]">arrow_back</span>
            </a>
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-[20px] text-primary">timer</span>
                <span class="font-headline-sm font-bold text-text-primary">Poste Miroir Direct</span>
            </div>
            <span class="px-2.5 py-0.5 rounded-full text-xs font-bold @ChronoStateBadgeClass">@_sessionStatus</span>
        </div>

        <div class="flex items-center gap-3">
            <a class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-lavender-subtle text-primary font-label-md font-bold hover:bg-primary hover:text-on-primary transition-colors shadow-sm" href="@($"/staff/fiche-technique/{IdRdv}")">
                <span class="material-symbols-outlined text-[18px]">assignment</span>
                <span>Fiche Technique</span>
            </a>
        </div>
    </header>

    <main class="pt-20 px-6 lg:px-10 pb-16 flex-1 flex flex-col gap-6 max-w-4xl w-full mx-auto">
        <!-- Client & Appointment Card -->
        <div class="bg-surface-cream rounded-2xl p-6 shadow-sm border border-outline-variant/30 flex flex-wrap items-center justify-between gap-4">
            <div class="flex items-center gap-4 min-w-0">
                <div class="w-14 h-14 rounded-full bg-primary-fixed text-primary font-bold text-xl flex items-center justify-center shrink-0">
                    @(_rdv?.NomClient?[..Math.Min(_rdv.NomClient.Length, 2)].ToUpperInvariant() ?? "CL")
                </div>
                <div class="min-w-0">
                    <div class="flex items-center gap-2">
                        <h1 class="font-headline-md font-bold text-text-primary truncate">@(_rdv?.NomClient ?? "Cliente")</h1>
                        <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-lavender-subtle text-primary">Fauteuil assigné</span>
                    </div>
                    <p class="font-label-md text-primary font-semibold truncate">@(_rdv?.LibellePrestation ?? "Soin Capillaire")</p>
                    <p class="font-body-sm text-on-surface-variant">Prévu pour @(_rdv?.DureeMinutes ?? 60) minutes</p>
                </div>
            </div>

            <!-- Sensitive Scalp Alert Pill -->
            <div class="flex items-center gap-2 px-3.5 py-2 rounded-xl bg-amber-500/10 text-amber-900 border border-amber-500/30">
                <span class="material-symbols-outlined text-[20px] text-amber-600">warning</span>
                <div class="text-xs">
                    <strong class="block font-bold">Cuir chevelu sensible</strong>
                    <span>Traction douce recommandée</span>
                </div>
            </div>
        </div>

        <!-- Big Chronometer Display Card -->
        <div class="bg-primary-container text-on-primary rounded-3xl p-8 shadow-xl flex flex-col items-center justify-center text-center relative overflow-hidden">
            <div class="absolute -right-20 -top-20 w-60 h-60 rounded-full bg-secondary/30 blur-3xl pointer-events-none"></div>
            <div class="absolute -left-20 -bottom-20 w-60 h-60 rounded-full bg-primary-fixed/20 blur-3xl pointer-events-none"></div>

            <span class="font-label-md uppercase tracking-widest text-on-primary-container font-bold mb-2">Chronomètre de Prestation</span>
            <div class="font-display-lg text-[64px] lg:text-[88px] font-mono font-bold tracking-tight text-on-primary my-2 leading-none">
                @TimeFormatted
            </div>

            <div class="flex items-center gap-2 text-on-primary-container font-label-md mb-6">
                <span>Temps théorique : @(_rdv?.DureeMinutes ?? 60) min</span>
                <span>•</span>
                <span>Pause cumulée : @(_pauseSeconds / 60) min</span>
            </div>

            <!-- Big Tactile Control Buttons -->
            <div class="flex flex-wrap items-center justify-center gap-4 w-full max-w-md">
                @if (_sessionState == "ready")
                {
                    <button class="flex-1 py-4 px-6 rounded-2xl bg-status-available hover:brightness-110 text-on-primary font-headline-sm font-bold shadow-lg transition-transform active:scale-95 flex items-center justify-center gap-2" @onclick='() => ChangeStateAsync("start")'>
                        <span class="material-symbols-outlined text-[28px]">play_arrow</span>
                        <span>Démarrer le soin</span>
                    </button>
                }
                else if (_sessionState == "started")
                {
                    <button class="flex-1 py-4 px-6 rounded-2xl bg-amber-500 hover:brightness-110 text-on-primary font-headline-sm font-bold shadow-lg transition-transform active:scale-95 flex items-center justify-center gap-2" @onclick='() => ChangeStateAsync("pause")'>
                        <span class="material-symbols-outlined text-[28px]">pause</span>
                        <span>Pause</span>
                    </button>
                    <button class="flex-1 py-4 px-6 rounded-2xl bg-secondary-container hover:brightness-110 text-on-primary font-headline-sm font-bold shadow-lg transition-transform active:scale-95 flex items-center justify-center gap-2" @onclick='() => ChangeStateAsync("finish")'>
                        <span class="material-symbols-outlined text-[28px]">check_circle</span>
                        <span>Terminer</span>
                    </button>
                }
                else if (_sessionState == "paused")
                {
                    <button class="flex-1 py-4 px-6 rounded-2xl bg-status-available hover:brightness-110 text-on-primary font-headline-sm font-bold shadow-lg transition-transform active:scale-95 flex items-center justify-center gap-2" @onclick='() => ChangeStateAsync("resume")'>
                        <span class="material-symbols-outlined text-[28px]">play_arrow</span>
                        <span>Reprendre</span>
                    </button>
                    <button class="flex-1 py-4 px-6 rounded-2xl bg-secondary-container hover:brightness-110 text-on-primary font-headline-sm font-bold shadow-lg transition-transform active:scale-95 flex items-center justify-center gap-2" @onclick='() => ChangeStateAsync("finish")'>
                        <span class="material-symbols-outlined text-[28px]">check_circle</span>
                        <span>Terminer</span>
                    </button>
                }
                else if (_sessionState == "finished")
                {
                    <div class="py-3 px-6 rounded-2xl bg-status-available/20 text-on-primary font-headline-sm font-bold flex items-center justify-center gap-2">
                        <span class="material-symbols-outlined text-[28px]">done_all</span>
                        <span>Prestation Terminée avec succès !</span>
                    </div>
                }
            </div>
        </div>

        <!-- Consommation de Produits au Poste (Mèches, Huiles) -->
        <div class="bg-surface-cream rounded-2xl p-6 shadow-sm border border-outline-variant/30 flex flex-col gap-4">
            <h3 class="font-headline-sm font-bold text-text-primary flex items-center gap-2">
                <span class="material-symbols-outlined text-primary text-[22px]">inventory_2</span>
                <span>Produits Utilisés &amp; Déstockage Poste</span>
            </h3>

            <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
                <div class="p-3 rounded-xl bg-surface-container-low border border-outline-variant/20 flex flex-col gap-1">
                    <span class="text-xs text-on-surface-variant font-bold uppercase">Mèches X-Pression</span>
                    <strong class="text-primary text-lg">3 paquets</strong>
                    <span class="text-[11px] text-status-available">Couleur #1B / 30</span>
                </div>
                <div class="p-3 rounded-xl bg-surface-container-low border border-outline-variant/20 flex flex-col gap-1">
                    <span class="text-xs text-on-surface-variant font-bold uppercase">Huile de Karité Bio</span>
                    <strong class="text-primary text-lg">1 dose (15ml)</strong>
                    <span class="text-[11px] text-on-surface-variant">Soin hydratant</span>
                </div>
                <div class="p-3 rounded-xl bg-surface-container-low border border-outline-variant/20 flex flex-col gap-1">
                    <span class="text-xs text-on-surface-variant font-bold uppercase">Shampoing Doux</span>
                    <strong class="text-primary text-lg">Au bac</strong>
                    <span class="text-[11px] text-status-available">Sans sulfate</span>
                </div>
                <div class="p-3 rounded-xl bg-surface-container-low border border-outline-variant/20 flex flex-col gap-1">
                    <span class="text-xs text-on-surface-variant font-bold uppercase">Boisson Servie</span>
                    <strong class="text-primary text-lg">Bissap frais</strong>
                    <span class="text-[11px] text-on-surface-variant">Boisson favorite</span>
                </div>
            </div>
        </div>
    </main>
</div>

@code {
    [Parameter] public Guid IdRdv { get; set; }
    private Guid? _idStaff;
    private PlanningItemDto? _rdv;
    private string _sessionState = "ready"; // ready, started, paused, finished
    private string _sessionStatus = "Prêt à démarrer";
    private int _elapsedSeconds = 0;
    private int _pauseSeconds = 0;
    private System.Threading.Timer? _timer;

    private string TimeFormatted => $"{_elapsedSeconds / 3600:D2}:{(_elapsedSeconds % 3600) / 60:D2}:{_elapsedSeconds % 60:D2}";

    private string ChronoStateBadgeClass => _sessionState switch
    {
        "started" => "bg-status-available/15 text-status-available",
        "paused" => "bg-amber-500/15 text-amber-700",
        "finished" => "bg-primary-fixed text-primary",
        _ => "bg-surface-container text-on-surface-variant"
    };

    protected override async Task OnInitializedAsync()
    {
        _idStaff = await Session.GetStaffIdAsync();
        if (_idStaff is null)
        {
            Navigation.NavigateTo("/login?role=collaboratrice");
            return;
        }

        var (ok, items) = await StaffApi.GetPlanningAsync(_idStaff.Value, CancellationToken.None);
        if (ok)
        {
            _rdv = items.FirstOrDefault(i => i.IdRdv == IdRdv);
        }

        _timer = new System.Threading.Timer(async _ =>
        {
            if (_sessionState == "started")
            {
                _elapsedSeconds++;
                await InvokeAsync(StateHasChanged);
            }
            else if (_sessionState == "paused")
            {
                _pauseSeconds++;
                await InvokeAsync(StateHasChanged);
            }
        }, null, 1000, 1000);
    }

    private async Task ChangeStateAsync(string action)
    {
        if (_idStaff is null) return;
        var (ok, status) = await StaffApi.UpdateWorkSessionAsync(_idStaff.Value, IdRdv, action, CancellationToken.None);
        if (ok)
        {
            _sessionState = action switch
            {
                "start" => "started",
                "pause" => "paused",
                "resume" => "started",
                "finish" => "finished",
                _ => _sessionState
            };
            _sessionStatus = _sessionState switch
            {
                "started" => "En direct au miroir",
                "paused" => "En pause",
                "finished" => "Prestation clôturée",
                _ => "Prêt"
            };
        }
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}
