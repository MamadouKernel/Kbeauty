@page "/admin/abonnements"
@inject AdminApiClient AdminApi
@inject AdminSessionService Session
@inject NavigationManager Navigation
@* prerender:false : voir AdminDossiers.razor pour le detail du bug de prerendering evite. *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Abonnements</PageTitle>
@using KekeBeauty.Web.Components.Layout
<AdminHeader ActivePath="/admin/abonnements" />
<main id="main-content" tabindex="-1" class="admin-page admin-legacy"><div class="admin-content">


@if (_checkingAuth)
{
    <p>Chargement…</p>
}
else if (_error)
{
    <div class="alert alert-danger">Le service est momentanément indisponible. Merci de réessayer.</div>
}
else
{
    <h1>Abonnements</h1>

    <div class="row g-2 mb-3">
        <div class="col-auto">
            <select class="form-select" @bind="_statut" @bind:after="LoadAsync">
                <option value="">Tous</option>
                <option value="ACTIF">Actifs</option>
                <option value="IMPAYE">Impayés</option>
                <option value="RESILIE">Résiliés</option>
            </select>
        </div>
    </div>

    <h2>Packs d'abonnement</h2>
    <p class="text-muted">Créez, modifiez ou supprimez librement des packs. Laissez une limite vide pour la rendre illimitée ; laissez un tarif vide pour empêcher la souscription sur cette périodicité.</p>
    <div class="row g-3 mb-3">
        @foreach (var formule in _formules)
        {
            <div class="col-12 col-lg-6">
                <div class="card h-100"><div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <h3 class="h5 mb-0">@formule.Libelle <small class="text-muted">(@formule.Formule)</small></h3>
                        <div class="d-flex gap-1">
                            @if (formule.EstDefaut)
                            {
                                <span class="badge bg-primary">Par défaut</span>
                            }
                            else if (!formule.EstActif)
                            {
                                <span class="badge bg-secondary">Inactif</span>
                            }
                            @if (formule.EstPromoActive)
                            {
                                <span class="badge bg-danger">Promo -@(formule.PromoPourcentage)%</span>
                            }
                        </div>
                    </div>
                    <label class="form-label mt-2">Libellé</label>
                    <input class="form-control" @bind="formule.Libelle" />
                    <div class="row g-2 mt-1">
                        <div class="col-6"><label class="form-label">Tarif mensuel (XOF)</label><input class="form-control" type="number" min="0" @bind="formule.TarifMensuel" /></div>
                        <div class="col-6"><label class="form-label">Tarif annuel (XOF)</label><input class="form-control" type="number" min="0" @bind="formule.TarifAnnuel" /></div>
                    </div>
                    <label class="form-label mt-2">Nombre maximum de prestations</label>
                    <input class="form-control" type="number" min="0" @bind="formule.LimitePrestations" />
                    <label class="form-label mt-2">Rendez-vous maximum par mois</label>
                    <input class="form-control" type="number" min="0" @bind="formule.LimiteRdvMensuels" />
                    <div class="form-check mt-3"><input class="form-check-input" type="checkbox" @bind="formule.PaiementMobile" /><label class="form-check-label">Paiement mobile</label></div>
                    <div class="form-check"><input class="form-check-input" type="checkbox" @bind="formule.GestionEquipe" /><label class="form-check-label">Gestion de l’équipe</label></div>
                    <div class="form-check"><input class="form-check-input" type="checkbox" @bind="formule.StatistiquesAvancees" /><label class="form-check-label">Statistiques avancées</label></div>
                    <div class="form-check mt-2"><input class="form-check-input" type="checkbox" @bind="formule.EstActif" /><label class="form-check-label">Actif (souscriptible par les partenaires)</label></div>

                    <label class="form-label mt-3">Avantages affichés (un par ligne, texte libre)</label>
                    <textarea class="form-control" rows="3" placeholder="Badge Vérifié Premium&#10;Support WhatsApp prioritaire" @bind="formule.AvantagesTexte"></textarea>

                    <fieldset class="border rounded p-2 mt-3">
                        <legend class="h6 px-1 mb-0" style="width:auto">Promotion</legend>
                        <div class="row g-2">
                            <div class="col-6"><label class="form-label">Réduction (%)</label><input class="form-control" type="number" min="1" max="95" @bind="formule.PromoPourcentage" /></div>
                            <div class="col-6"><label class="form-label">Fin (optionnel)</label><input class="form-control" type="datetime-local" @bind="formule.PromoFinLocale" /></div>
                        </div>
                        @if (formule.PromoPourcentage is not null)
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary mt-2" @onclick="() => { formule.PromoPourcentage = null; formule.PromoFinLocale = null; }">Retirer la promo</button>
                        }
                    </fieldset>

                    <div class="d-flex gap-2 mt-3 flex-wrap">
                        <button class="btn btn-primary" @onclick="() => SaveFormuleAsync(formule)">Enregistrer</button>
                        @if (!formule.EstDefaut)
                        {
                            <button class="btn btn-outline-secondary" @onclick="() => SetDefaultAsync(formule)">Définir par défaut</button>
                            <button class="btn btn-outline-danger" @onclick="() => DeleteFormuleAsync(formule)">Supprimer</button>
                        }
                    </div>
                </div></div>
            </div>
        }
    </div>

    <details class="mb-4">
        <summary class="mb-2">Créer un nouveau pack</summary>
        <div class="card"><div class="card-body">
            <div class="row g-2">
                <div class="col-md-3"><label class="form-label">Code (ex : PREMIUM)</label><input class="form-control" @bind="_nouveauFormule.Formule" placeholder="PREMIUM" /></div>
                <div class="col-md-4"><label class="form-label">Libellé</label><input class="form-control" @bind="_nouveauFormule.Libelle" placeholder="Premium" /></div>
                <div class="col-md-2"><label class="form-label">Ordre</label><input class="form-control" type="number" @bind="_nouveauFormule.OrdreAffichage" /></div>
                <div class="col-md-3"></div>
                <div class="col-md-3"><label class="form-label">Tarif mensuel</label><input class="form-control" type="number" min="0" @bind="_nouveauFormule.TarifMensuel" /></div>
                <div class="col-md-3"><label class="form-label">Tarif annuel</label><input class="form-control" type="number" min="0" @bind="_nouveauFormule.TarifAnnuel" /></div>
                <div class="col-md-3"><label class="form-label">Limite prestations</label><input class="form-control" type="number" min="0" @bind="_nouveauFormule.LimitePrestations" /></div>
                <div class="col-md-3"><label class="form-label">Limite RDV/mois</label><input class="form-control" type="number" min="0" @bind="_nouveauFormule.LimiteRdvMensuels" /></div>
            </div>
            <div class="form-check mt-3"><input class="form-check-input" type="checkbox" @bind="_nouveauFormule.PaiementMobile" /><label class="form-check-label">Paiement mobile</label></div>
            <div class="form-check"><input class="form-check-input" type="checkbox" @bind="_nouveauFormule.GestionEquipe" /><label class="form-check-label">Gestion de l’équipe</label></div>
            <div class="form-check"><input class="form-check-input" type="checkbox" @bind="_nouveauFormule.StatistiquesAvancees" /><label class="form-check-label">Statistiques avancées</label></div>
            <label class="form-label mt-3">Avantages affichés (un par ligne, texte libre)</label>
            <textarea class="form-control" rows="3" placeholder="Badge Vérifié Premium&#10;Support WhatsApp prioritaire" @bind="_nouveauFormule.AvantagesTexte"></textarea>
            <fieldset class="border rounded p-2 mt-3">
                <legend class="h6 px-1 mb-0" style="width:auto">Promotion (optionnel)</legend>
                <div class="row g-2">
                    <div class="col-6"><label class="form-label">Réduction (%)</label><input class="form-control" type="number" min="1" max="95" @bind="_nouveauFormule.PromoPourcentage" /></div>
                    <div class="col-6"><label class="form-label">Fin (optionnel)</label><input class="form-control" type="datetime-local" @bind="_nouveauFormule.PromoFinLocale" /></div>
                </div>
            </fieldset>
            <button class="btn btn-primary mt-3" @onclick="CreateFormuleAsync">Créer le pack</button>
        </div></div>
    </details>

    @if (_abonnements.Count == 0)
    {
        <p>Aucun abonnement pour ce filtre.</p>
    }
    else
    {
        <div class="table-scroll" role="region" aria-label="Liste des abonnements" tabindex="0"><table class="table">
            <thead><tr><th>Établissement</th><th>Pack</th><th>Périodicité</th><th>Montant</th><th>Statut</th><th>Actions</th></tr></thead>
            <tbody>
                @foreach (var abonnement in _abonnements)
                {
                    <tr>
                        <td>@abonnement.IdEtablissement</td>
                        <td>@abonnement.Formule</td>
                        <td>@abonnement.Periodicite</td>
                        <td>@abonnement.Montant.ToString("N0") XOF</td>
                        <td>@abonnement.StatutAbonnement</td>
                        <td>
                            @if (abonnement.StatutAbonnement == "IMPAYE")
                            {
                                <button class="btn btn-sm btn-outline-warning" @onclick="() => RelancerAsync(abonnement.IdAbonnement)">Relancer</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table></div>
    }

}

</div></main>
<ToastBridge Message="@_message" Severity="@(_success ? "success" : "danger")" OnShown="@(() => _message = null)" />

@code {
    private string? _apiKey;
    private bool _checkingAuth = true;
    private bool _error;
    private string _statut = "";
    private List<AbonnementResume> _abonnements = [];
    private List<ConfigurationFormuleDto> _formules = [];
    private ConfigurationFormuleDto _nouveauFormule = new();
    private bool _success;
    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        _apiKey = await Session.GetApiKeyAsync();
        if (_apiKey is null)
        {
            Navigation.NavigateTo("/admin/login");
            return;
        }

        await LoadAsync();
        await LoadFormulesAsync();
        _checkingAuth = false;
    }

    private async Task LoadFormulesAsync()
    {
        var (success, formules) = await AdminApi.ListerFormulesAsync(_apiKey!, CancellationToken.None);
        if (success) _formules = formules;
    }

    private async Task SaveFormuleAsync(ConfigurationFormuleDto formule)
    {
        var (success, _) = await AdminApi.UpdateFormuleAsync(_apiKey!, formule, CancellationToken.None);
        _success = success;
        _message = success ? $"Pack {formule.Libelle} mis à jour." : "Impossible de modifier le contenu du pack.";
        if (success) await LoadFormulesAsync();
    }

    private async Task CreateFormuleAsync()
    {
        if (string.IsNullOrWhiteSpace(_nouveauFormule.Formule) || string.IsNullOrWhiteSpace(_nouveauFormule.Libelle))
        {
            _success = false;
            _message = "Code et libellé requis pour créer un pack.";
            return;
        }

        var (success, status) = await AdminApi.CreateFormuleAsync(_apiKey!, _nouveauFormule, CancellationToken.None);
        _success = success;
        _message = success ? $"Pack {_nouveauFormule.Libelle} créé." : status switch
        {
            "formule_existe_deja" => "Ce code de pack existe déjà.",
            _ => "Impossible de créer ce pack (code invalide : lettres/chiffres/underscore uniquement).",
        };
        if (success)
        {
            _nouveauFormule = new();
            await LoadFormulesAsync();
        }
    }

    private async Task SetDefaultAsync(ConfigurationFormuleDto formule)
    {
        var (success, _) = await AdminApi.SetFormuleParDefautAsync(_apiKey!, formule.Formule, CancellationToken.None);
        _success = success;
        _message = success ? $"{formule.Libelle} est désormais le pack par défaut." : "Action impossible (le pack doit être actif).";
        if (success) await LoadFormulesAsync();
    }

    private async Task DeleteFormuleAsync(ConfigurationFormuleDto formule)
    {
        var (success, status) = await AdminApi.DeleteFormuleAsync(_apiKey!, formule.Formule, CancellationToken.None);
        _success = success;
        _message = success ? $"Pack {formule.Libelle} supprimé." : status switch
        {
            "formule_par_defaut" => "Impossible : ce pack est le pack par défaut. Définissez-en un autre par défaut d'abord.",
            "derniere_formule" => "Impossible de supprimer le dernier pack restant.",
            "formule_utilisee" => "Impossible : des boutiques ont déjà souscrit à ce pack.",
            _ => "Suppression impossible.",
        };
        if (success) await LoadFormulesAsync();
    }

    private async Task LoadAsync()
    {
        var (success, abonnements) = await AdminApi.ListAbonnementsAsync(_apiKey!, string.IsNullOrEmpty(_statut) ? null : _statut, CancellationToken.None);
        _error = !success;
        _abonnements = abonnements;
    }

    private async Task RelancerAsync(Guid idAbonnement)
    {
        var (success, notificationEnvoyee) = await AdminApi.RelancerAsync(_apiKey!, idAbonnement, CancellationToken.None);
        _success = success;
        _message = success
            ? notificationEnvoyee ? "Relance envoyée." : "Relance tentée, notification non envoyée (Zavu non configuré)."
            : "Action impossible.";
    }
}
