{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Cors": {
    "Origins": [ "http://localhost:4200" ]
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedOnStartup": false
  },
  "Jwt": {
    "Issuer": "keke-beauty",
    "Audience": "keke-beauty-web",
    "AccessTokenMinutes": 15
  },
  "Auth": {
    "WebBaseUrl": "http://localhost:4200",
    "TotpIssuer": "Keke Beauty",
    "Google": {
      "Enabled": false,
      "ClientId": ""
    },
    "WhatsApp": {
      "Enabled": false
    }
  },
  "AllowedHosts": "*"
}
