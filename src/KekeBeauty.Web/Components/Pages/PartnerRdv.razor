@page "/partenaire/etablissements/{Id:guid}/rdv"
@inject PartnerRdvApiClient PartnerRdvApi
@inject PartnerSessionService Session
@inject NavigationManager Navigation
@* prerender:false : voir PartnerDashboard.razor pour le detail du bug de prerendering evite. *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Demandes de RDV</PageTitle>

@if (_checkingAuth)
{
    <p>Chargement…</p>
}
else if (_error)
{
    <div class="alert alert-danger">Le service est momentanément indisponible. Merci de réessayer.</div>
}
else
{
    <h1>Demandes de RDV</h1>

    @if (_rdvs.Count == 0)
    {
        <p>Aucune demande de RDV pour cet établissement.</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr><th>Date/heure</th><th>Prestation</th><th>Client</th><th>Statut</th><th>Actions</th></tr>
            </thead>
            <tbody>
                @foreach (var rdv in _rdvs)
                {
                    <tr>
                        <td>@rdv.DateHeureDebut.ToLocalTime().ToString("g")</td>
                        <td>@rdv.LibellePrestation</td>
                        <td>@rdv.TelephoneClient</td>
                        <td>@rdv.StatutRdv</td>
                        <td>
                            @if (rdv.StatutRdv == "DEMANDE")
                            {
                                <button class="btn btn-sm btn-success" @onclick="() => ConfirmerAsync(rdv.IdRdv)">Confirmer</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => RefuserAsync(rdv.IdRdv)">Refuser</button>
                            }
                            @if (rdv.StatutRdv is "DEMANDE" or "CONFIRME")
                            {
                                @if (_idRdvEnReprogrammation == rdv.IdRdv)
                                {
                                    <input type="datetime-local" class="form-control form-control-sm d-inline-block" style="width:auto" @bind="_nouvelleDateHeure" />
                                    <button class="btn btn-sm btn-primary" @onclick="() => ReprogrammerAsync(rdv.IdRdv)">Valider</button>
                                    <button class="btn btn-sm btn-link" @onclick="() => _idRdvEnReprogrammation = null">Annuler</button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => StartReprogrammer(rdv)">Reprogrammer</button>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert @(_success ? "alert-success" : "alert-danger")">@_message</div>
    }
}

@code {
    [Parameter] public Guid Id { get; set; }

    private Guid? _idPartner;
    private List<RdvPartenaire> _rdvs = [];
    private bool _checkingAuth = true;
    private bool _error;
    private bool _success;
    private string? _message;
    private Guid? _idRdvEnReprogrammation;
    private DateTime _nouvelleDateHeure = DateTime.Now;

    protected override async Task OnInitializedAsync()
    {
        _idPartner = await Session.GetPartnerIdAsync();
        if (_idPartner is null)
        {
            Navigation.NavigateTo("/login?role=partenaire");
            return;
        }

        await LoadAsync();
        _checkingAuth = false;
    }

    private async Task LoadAsync()
    {
        var (success, rdvs) = await PartnerRdvApi.ListAsync(_idPartner!.Value, Id, CancellationToken.None);
        _error = !success;
        _rdvs = rdvs;
    }

    private async Task ConfirmerAsync(Guid idRdv)
    {
        var (success, status) = await PartnerRdvApi.ConfirmerAsync(_idPartner!.Value, Id, idRdv, CancellationToken.None);
        _success = success;
        _message = success ? "RDV confirmé." : "Action impossible (RDV introuvable ou déjà traité).";
        if (success)
        {
            await LoadAsync();
        }
    }

    private async Task RefuserAsync(Guid idRdv)
    {
        var (success, status) = await PartnerRdvApi.RefuserAsync(_idPartner!.Value, Id, idRdv, CancellationToken.None);
        _success = success;
        _message = success ? "RDV refusé." : "Action impossible (RDV introuvable ou déjà traité).";
        if (success)
        {
            await LoadAsync();
        }
    }

    private void StartReprogrammer(RdvPartenaire rdv)
    {
        _idRdvEnReprogrammation = rdv.IdRdv;
        _nouvelleDateHeure = rdv.DateHeureDebut.ToLocalTime().DateTime;
    }

    private async Task ReprogrammerAsync(Guid idRdv)
    {
        var nouvelleDateHeureDebut = new DateTimeOffset(_nouvelleDateHeure, TimeZoneInfo.Local.GetUtcOffset(_nouvelleDateHeure));
        var (success, status) = await PartnerRdvApi.ReprogrammerAsync(_idPartner!.Value, Id, idRdv, nouvelleDateHeureDebut, CancellationToken.None);
        _success = success;
        _message = success
            ? "RDV reprogrammé."
            : status == "slot_unavailable_or_not_found"
                ? "Ce créneau n'est plus disponible ou ce RDV est introuvable. Choisissez un autre créneau."
                : "Action impossible.";
        if (success)
        {
            _idRdvEnReprogrammation = null;
            await LoadAsync();
        }
    }
}
